@using System.IO
@using TordeX.Core.Models
@using TordeX.Core.Services
@using Microsoft.JSInterop
@inject ChatService Chat
@inject IJSRuntime JS
@implements IDisposable

<!-- Pinned Messages Bar -->
@if (_pinnedMessages.Count > 0)
{
    <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-secondary)] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors"
         @onclick="() => _showPinnedList = !_showPinnedList">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 1v4M4 5h4l1 3H3l1-3zM6 8v3" stroke="var(--accent)" stroke-width="1" stroke-linecap="round"/>
        </svg>
        <span class="text-[12px] text-[var(--text-secondary)]">@_pinnedMessages.Count pinned message(s)</span>
    </div>
}

<!-- Search Bar -->
@if (_showSearch)
{
    <div class="flex items-center gap-2 px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-secondary)]">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" placeholder="Search messages..." autofocus
               class="flex-1 bg-transparent text-[13px] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none"
               @bind="_searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
        <span class="text-[11px] text-[var(--text-muted)]">@_searchResults.Count results</span>
        <button class="p-1 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                @onclick="CloseSearch">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>
}

<!-- Chat Header -->
<div class="flex items-center justify-between px-5 py-3 border-b border-[var(--border)] bg-[var(--bg-secondary)]">
    <div class="flex items-center gap-3">
        <h2 class="text-[16px] font-semibold text-[var(--text-primary)]">@Room.Name</h2>
        @if (!string.IsNullOrEmpty(Room.Description))
        {
            <span class="text-[11px] text-[var(--text-muted)]">@Room.Description</span>
        }
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-[var(--radius-sm)] bg-[rgba(46,204,113,0.1)] text-[var(--success)] text-[11px] font-medium">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            E2E
        </span>
    </div>
    <div class="flex items-center gap-1">
        <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                title="@L("Bookmarks")" @onclick="() => _showBookmarks = !_showBookmarks">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
        </button>
        <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                title="@L("SearchMessages")" @onclick="() => _showSearch = !_showSearch">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
        </button>
        <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                title="@L("RoomInformation")" @onclick="ToggleRoomInfo">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
        </button>
    </div>
</div>

<!-- Message List -->
<div class="flex-1 overflow-y-auto px-5 py-4" @ref="_messagesContainer" id="chat-messages"
     @ondragenter="HandleDragEnter" @ondragleave="HandleDragLeave" @ondragover:preventDefault
     @ondrop="HandleDrop" @ondrop:preventDefault>
    @if (_displayMessages.Count == 0)
    {
        <div class="flex flex-col items-center justify-center h-full gap-3">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5;">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                <rect x="8" y="9" width="8" height="6" rx="1"/>
            </svg>
            <p class="text-[14px] font-semibold text-[var(--text-muted)]">Start Chatting</p>
            <p class="text-[12px] text-[var(--text-muted)]">Messages are end-to-end encrypted with AES-256-GCM.</p>
        </div>
    }
    else
    {
        <div class="flex flex-col">
            @foreach (var msg in _displayMessages)
            {
                @if (msg.Type == MessageType.System)
                {
                    <div class="flex justify-center py-2">
                        <span class="text-[11px] text-[var(--text-muted)] px-3 py-1 rounded-full bg-[var(--bg-tertiary)]">@msg.Content</span>
                    </div>
                }
                else if (msg.IsDeleted)
                {
                    <div class="flex py-1 @(msg.IsOwn ? "justify-end" : "justify-start")">
                        <span class="text-[13px] italic text-[var(--text-muted)]">This message was deleted</span>
                    </div>
                }
                else
                {
                    <div class="message-group flex py-1 relative @(msg.IsOwn ? "justify-end" : "justify-start")"
                         @oncontextmenu="(e) => ShowContextMenu(e, msg)" @oncontextmenu:preventDefault="true">
                        <div class="max-w-[70%] flex flex-col">
                            @if (!msg.IsOwn)
                            {
                                <div class="flex items-center gap-1.5 mb-1 px-1">
                                    <span class="w-5 h-5 rounded-full bg-[var(--accent-glow)] text-[var(--accent)] text-[10px] font-bold flex items-center justify-center shrink-0">@msg.SenderDisplayName[0..1].ToUpper()</span>
                                    <span class="text-[12px] font-semibold text-[var(--accent-light)]">@msg.SenderDisplayName</span>
                                    @if (Chat.IsUserBlocked(msg.SenderFingerprint))
                                    {
                                        <span class="text-[10px] text-[var(--danger)]">[blocked]</span>
                                    }
                                </div>
                            }

                            @if (msg.IsPinned)
                            {
                                <div class="flex items-center gap-1 mb-1 px-1">
                                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                        <path d="M5 1v3M3.5 4h3l.5 2H3l.5-2zM5 6v3" stroke="var(--accent)" stroke-width="0.8" stroke-linecap="round"/>
                                    </svg>
                                    <span class="text-[10px] text-[var(--text-muted)]">Pinned</span>
                                </div>
                            }

                            @if (msg.ReplyToContent is not null)
                            {
                                <div class="flex items-stretch mb-1.5 rounded-[var(--radius-sm)] overflow-hidden bg-[var(--bg-hover)]">
                                    <div class="w-[3px] bg-[var(--accent)] shrink-0"></div>
                                    <div class="px-2 py-1.5 min-w-0">
                                        <p class="text-[11px] font-semibold text-[var(--accent-light)] truncate">@(msg.ReplyToSenderName ?? "Unknown")</p>
                                        <p class="text-[11px] text-[var(--text-muted)] truncate">@TruncateText(msg.ReplyToContent, 80)</p>
                                    </div>
                                </div>
                            }

                            @if (msg.Type == MessageType.Text)
                            {
                                <div class="@(msg.IsOwn ? "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-br-[var(--radius-sm)] bg-[var(--accent-dark)] text-[#fff]" : "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-bl-[var(--radius-sm)] bg-[var(--bg-tertiary)] text-[var(--text-primary)]")">
                                    <div class="msg-markdown text-[13px] leading-relaxed whitespace-pre-wrap break-words">@((MarkupString)MarkdownService.Render(msg.Content))</div>
                                    @if (msg.EditedAt.HasValue)
                                    {
                                        <span class="text-[10px] opacity-50 ml-1">(@L("Edited"))</span>
                                    }
                                </div>
                                @if (GetFirstUrl(msg.Content) is string firstUrl)
                                {
                                    <div class="link-preview mt-1.5 cursor-pointer" @onclick="() => OpenUrl(firstUrl)">
                                        <div class="link-preview-info">
                                            <div class="link-preview-title">@L("LinkPreview")</div>
                                            <div class="link-preview-url">@firstUrl</div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (msg.Type == MessageType.Image)
                            {
                                <div class="@(msg.IsOwn ? "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-br-[var(--radius-sm)] bg-[var(--accent-dark)] text-[#fff]" : "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-bl-[var(--radius-sm)] bg-[var(--bg-tertiary)] text-[var(--text-primary)]")">
                                    @if (msg.IsViewOnce)
                                    {
                                        <div class="view-once-badge">👁 @L("ViewOnce")</div>
                                    }
                                    @if (msg.IsViewOnce && msg.ViewedAt.HasValue && !msg.IsOwn)
                                    {
                                        <div class="view-once-overlay">
                                            <span>👁 @L("ViewOnceOpened")</span>
                                        </div>
                                    }
                                    else if (msg.IsViewOnce && !msg.ViewedAt.HasValue && !msg.IsOwn)
                                    {
                                        <div class="view-once-blur" @onclick="() => OpenViewOnce(msg)">
                                            <div class="view-once-overlay">
                                                <span>👁 @L("ViewOnce")</span>
                                            </div>
                                        </div>
                                    }
                                    else if (_imageCache.TryGetValue(msg.Content, out var imgSrc))
                                    {
                                        <div class="mb-1.5 rounded-[var(--radius-sm)] overflow-hidden cursor-pointer">
                                            <img src="@imgSrc" class="inline-image" alt="@(msg.FileName ?? "Image")"
                                                 @onclick="() => ShowImageFullscreen(imgSrc)" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-2.5 p-2 rounded-[var(--radius-sm)] bg-[rgba(0,0,0,0.2)] cursor-pointer" @onclick="() => LoadImagePreview(msg)">
                                            <span class="text-[20px]">📷</span>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-[12px] font-semibold truncate">@(msg.FileName ?? "Image")</p>
                                                <span class="text-[10px] opacity-70">@FormatFileSize(msg.FileSize ?? 0) - Click to load</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (msg.Type == MessageType.Video)
                            {
                                <div class="@(msg.IsOwn ? "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-br-[var(--radius-sm)] bg-[var(--accent-dark)] text-[#fff]" : "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-bl-[var(--radius-sm)] bg-[var(--bg-tertiary)] text-[var(--text-primary)]")">
                                    <div class="flex items-center gap-2.5 p-2 rounded-[var(--radius-sm)] bg-[rgba(0,0,0,0.2)]">
                                        <span class="text-[20px]">🎬</span>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-[12px] font-semibold truncate">@(msg.FileName ?? "Video")</p>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <span class="text-[10px] opacity-70">@FormatFileSize(msg.FileSize ?? 0)</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded-[var(--radius-sm)] bg-[rgba(46,204,113,0.15)] text-[var(--success)]">Encrypted</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (msg.Type == MessageType.Voice)
                            {
                                <div class="@(msg.IsOwn ? "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-br-[var(--radius-sm)] bg-[var(--accent-dark)] text-[#fff]" : "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-bl-[var(--radius-sm)] bg-[var(--bg-tertiary)] text-[var(--text-primary)]")">
                                    <div class="voice-message">
                                        <button class="voice-play-btn" @onclick="() => PlayVoice(msg)">
                                            @if (_playingMessageId == msg.Id)
                                            {
                                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                                    <rect x="3" y="3" width="4" height="10" rx="1" fill="currentColor"/>
                                                    <rect x="9" y="3" width="4" height="10" rx="1" fill="currentColor"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                                    <path d="M4 3l9 5-9 5V3z" fill="currentColor"/>
                                                </svg>
                                            }
                                        </button>
                                        <div class="voice-waveform">
                                            @for (int i = 0; i < 20; i++)
                                            {
                                                <div class="voice-bar" style="height: @(8 + Random.Shared.Next(16))px;@(_playingMessageId == msg.Id ? " background: var(--accent);" : "")"></div>
                                            }
                                        </div>
                                        <span class="voice-duration">@FormatDuration(msg.VoiceDuration ?? 0)</span>
                                    </div>
                                </div>
                            }
                            else if (msg.Type == MessageType.File)
                            {
                                <div class="@(msg.IsOwn ? "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-br-[var(--radius-sm)] bg-[var(--accent-dark)] text-[#fff]" : "px-3.5 py-2 rounded-[var(--radius-lg)] rounded-bl-[var(--radius-sm)] bg-[var(--bg-tertiary)] text-[var(--text-primary)]")">
                                    <div class="flex items-center gap-2.5 p-2 rounded-[var(--radius-sm)] bg-[rgba(0,0,0,0.2)]">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="@(msg.IsOwn ? "#fff" : "var(--text-secondary)")" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                        </svg>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-[12px] font-semibold truncate">@(msg.FileName ?? "File")</p>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <span class="text-[10px] opacity-70">@FormatFileSize(msg.FileSize ?? 0)</span>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded-[var(--radius-sm)] bg-[rgba(46,204,113,0.15)] text-[var(--success)]">Encrypted</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ── Reactions Bar ── *@
                            @if (msg.Reactions is not null && msg.Reactions.Count > 0)
                            {
                                <div class="flex items-center gap-1 mt-1 px-1">
                                    @foreach (var reaction in msg.Reactions)
                                    {
                                        var isOwn = reaction.Value.Contains(Chat.CurrentUser?.Id ?? "");
                                        <button class="inline-flex items-center gap-1 px-1.5 py-0.5 text-[11px] rounded-full border cursor-pointer bg-transparent @(isOwn ? "border-[var(--accent)] bg-[var(--accent-glow)]" : "border-[var(--border)] bg-[var(--bg-tertiary)]")"
                                                @onclick="() => ToggleReaction(msg, reaction.Key)">
                                            <span>@reaction.Key</span>
                                            <span class="text-[var(--text-secondary)]">@reaction.Value.Count</span>
                                        </button>
                                    }
                                    <button class="reaction-add-btn" @onclick="() => ShowReactionPicker(msg)">+</button>
                                </div>
                            }

                            <div class="flex items-center gap-1 mt-1 px-1 @(msg.IsOwn ? "justify-end" : "justify-start")"
                                 style="@(Chat.CurrentUser?.ShowTimestamps == false ? "display: none;" : "")">
                                <span class="text-[11px] text-[var(--text-muted)]">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                @if (msg.IsOwn)
                                {
                                    <span class="text-[11px] @(msg.IsRead ? "text-[var(--accent)]" : "text-[var(--text-muted)]")">
                                        @if (msg.IsRead)
                                        { <text>✓✓</text> }
                                        else if (msg.IsDelivered)
                                        { <text>✓</text> }
                                    </span>
                                }
                                @if (msg.SelfDestructAt.HasValue)
                                {
                                    <span class="text-[11px]" title="Self-destructs">⏱️</span>
                                }
                            </div>

                            <!-- Hover actions -->
                            <div class="message-actions">
                                <button class="msg-action-btn" title="@L("AddReaction")" @onclick="() => ShowReactionPicker(msg)">😊</button>
                                <button class="msg-action-btn" title="@L("Reply")" @onclick="() => StartReply(msg)">↩</button>
                                <button class="msg-action-btn @(msg.IsBookmarked ? "active" : "")"
                                        title="@L("Bookmark")" @onclick="() => ToggleBookmark(msg)">🔖</button>
                                @if (msg.IsOwn)
                                {
                                    <button class="msg-action-btn" title="@L("Edit")" @onclick="() => StartEdit(msg)">✏</button>
                                    <button class="msg-action-btn" title="@L("Delete")" @onclick="() => DeleteMessage(msg)">🗑</button>
                                }
                                <button class="msg-action-btn" title="@L("Forward")" @onclick="() => StartForward(msg)">↗</button>
                                <button class="msg-action-btn" title="@(msg.IsPinned ? L("Unpin") : L("Pin"))" @onclick="() => TogglePin(msg)">📌</button>
                                @if (!msg.IsOwn)
                                {
                                    <button class="msg-action-btn" title="@L("BlockUser")" @onclick="() => BlockSender(msg)">🚫</button>
                                }
                            </div>

                            @* ── Reaction Quick Picker ── *@
                            @if (_reactionPickerTarget?.Id == msg.Id)
                            {
                                <div class="reaction-picker-mini">
                                    @foreach (var emoji in _quickReactions)
                                    {
                                        <button @onclick="() => AddReaction(msg, emoji)">@emoji</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<!-- Context Menu -->
@if (_showContextMenu)
{
    <div class="context-menu-backdrop" @onclick="CloseContextMenu">
        <div class="context-menu" style="top: @(_contextMenuY)px; left: @(_contextMenuX)px;" @onclick:stopPropagation="true">
            <button class="context-menu-item" @onclick="() => { StartReply(_contextMessage!); CloseContextMenu(); }">↩ Reply</button>
            @if (_contextMessage?.IsOwn == true)
            {
                <button class="context-menu-item" @onclick="() => { StartEdit(_contextMessage!); CloseContextMenu(); }">✏ Edit</button>
                <button class="context-menu-item danger" @onclick="async () => { await DeleteMessage(_contextMessage!); CloseContextMenu(); }">🗑 Delete</button>
            }
            <button class="context-menu-item" @onclick="() => { StartForward(_contextMessage!); CloseContextMenu(); }">↗ Forward</button>
            <button class="context-menu-item" @onclick="async () => { await TogglePin(_contextMessage!); CloseContextMenu(); }">📌 @(_contextMessage?.IsPinned == true ? "Unpin" : "Pin")</button>
            <button class="context-menu-item" @onclick="async () => { await CopyMessage(_contextMessage!); CloseContextMenu(); }">📋 @L("Copy")</button>
            <button class="context-menu-item" @onclick="async () => { await ToggleBookmark(_contextMessage!); CloseContextMenu(); }">
                🔖 @(_contextMessage?.IsBookmarked == true ? L("RemoveBookmark") : L("Bookmark"))
            </button>
            <button class="context-menu-item" @onclick="() => { ShowReactionPicker(_contextMessage!); CloseContextMenu(); }">😊 @L("AddReaction")</button>
            @if (_contextMessage?.IsOwn == false)
            {
                <hr class="context-menu-divider" />
                <button class="context-menu-item danger" @onclick="async () => { await BlockSender(_contextMessage!); CloseContextMenu(); }">🚫 @L("BlockUser")</button>
            }
        </div>
    </div>
}

<!-- Drag & Drop Overlay -->
@if (_isDragOver)
{
    <div class="drag-overlay">
        <div class="drag-content">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <rect x="8" y="8" width="32" height="32" rx="4" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4"/>
                <path d="M24 18v12M18 24h12" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <p>Drop file here to send encrypted</p>
        </div>
    </div>
}

<!-- Fullscreen Image -->
@if (_fullscreenImage is not null)
{
    <div class="image-fullscreen" @onclick="() => _fullscreenImage = null">
        <img src="@_fullscreenImage" alt="Full size" />
    </div>
}

<!-- Forward Dialog -->
@if (_showForwardDialog)
{
    <div class="fixed inset-0 z-[1000] flex items-center justify-center" @onclick="() => _showForwardDialog = false">
        <div class="absolute inset-0 bg-[rgba(0,0,0,0.7)]"></div>
        <div class="relative w-full max-w-[420px] rounded-[var(--radius-lg)] bg-[var(--bg-secondary)] border border-[var(--border)] p-6"
             style="box-shadow: var(--shadow-lg); animation: slideUp 250ms ease;"
             @onclick:stopPropagation="true">
            <h3 class="text-[16px] font-semibold text-[var(--text-primary)] mb-4">Forward Message</h3>
            <p class="text-[12px] text-[var(--text-muted)] mb-3">Select a room to forward to:</p>
            @foreach (var room in _allRooms.Where(r => r.Id != Room.Id))
            {
                <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-[var(--radius-md)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none text-left mb-1"
                        @onclick="() => ForwardToRoom(room)">
                    <span class="w-8 h-8 rounded-[var(--radius-md)] bg-[var(--accent-glow)] text-[var(--accent)] text-[12px] font-bold flex items-center justify-center shrink-0">@room.Name[0..1].ToUpper()</span>
                    <span class="text-[13px] text-[var(--text-primary)]">@room.Name</span>
                </button>
            }
            <button class="w-full h-9 mt-3 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                    @onclick="() => _showForwardDialog = false">Cancel</button>
        </div>
    </div>
}

<!-- Input Area -->
<div class="border-t border-[var(--border)] bg-[var(--bg-secondary)]">
    @if (_replyingTo is not null)
    {
        <div class="flex items-stretch px-4 pt-3">
            <div class="w-[3px] rounded-full bg-[var(--accent)] shrink-0"></div>
            <div class="flex-1 flex items-center justify-between px-3 py-2 rounded-r-[var(--radius-sm)] bg-[var(--bg-tertiary)]">
                <div class="min-w-0">
