    // ──── Reactions ────

    private void ShowReactionPicker(ChatMessage msg)
    {
        _reactionPickerTarget = _reactionPickerTarget?.Id == msg.Id ? null : msg;
        StateHasChanged();
    }

    private async Task AddReaction(ChatMessage msg, string emoji)
    {
        try
        {
            await Chat.AddReactionAsync(msg.Id, Room.Id, emoji);
            var fp = Chat.CurrentUser?.Id ?? "";
            msg.Reactions ??= new Dictionary<string, List<string>>();
            if (!msg.Reactions.ContainsKey(emoji))
                msg.Reactions[emoji] = [];
            if (!msg.Reactions[emoji].Contains(fp))
                msg.Reactions[emoji].Add(fp);
        }
        catch (Exception ex) { AddSystemMessage($"Reaction failed: {ex.Message}"); }
        _reactionPickerTarget = null;
        StateHasChanged();
    }

    private async Task ToggleReaction(ChatMessage msg, string emoji)
    {
        var fp = Chat.CurrentUser?.Id ?? "";
        if (msg.Reactions?.ContainsKey(emoji) == true && msg.Reactions[emoji].Contains(fp))
        {
            try
            {
                await Chat.RemoveReactionAsync(msg.Id, Room.Id, emoji);
                msg.Reactions[emoji].Remove(fp);
                if (msg.Reactions[emoji].Count == 0)
                    msg.Reactions.Remove(emoji);
            }
            catch (Exception ex) { AddSystemMessage($"Remove reaction failed: {ex.Message}"); }
        }
        else
        {
            await AddReaction(msg, emoji);
            return;
        }
        StateHasChanged();
    }

    // ──── Bookmarks ────

    private async Task ToggleBookmark(ChatMessage msg)
    {
        try
        {
            await Chat.ToggleBookmarkAsync(msg, Room.Name);
            msg.IsBookmarked = !msg.IsBookmarked;
            StateHasChanged();
