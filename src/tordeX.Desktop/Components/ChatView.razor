    // ──── Helpers ────

    private void AddSystemMessage(string content)
    {
        _messages.Add(new ChatMessage
        {
            Id = Guid.NewGuid().ToString("N"),
            RoomId = Room.Id,
            SenderFingerprint = "system",
            SenderDisplayName = "System",
            Type = MessageType.System,
            Content = content,
            Timestamp = DateTimeOffset.UtcNow
        });
        _displayMessages = _messages;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1073741824) return $"{bytes / 1048576.0:F1} MB";
        return $"{bytes / 1073741824.0:F1} GB";
    }

    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"0:{ts.Seconds:D2}";
    }

    private static string TruncateText(string text, int maxLen)
        => text.Length <= maxLen ? text : text[..maxLen] + "...";

    private static string? GetFirstUrl(string text)
    {
        var urls = MarkdownService.ExtractUrls(text);
        return urls.Count > 0 ? urls[0] : null;
    }
