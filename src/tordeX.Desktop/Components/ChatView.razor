                    <p class="text-[11px] text-[var(--text-muted)] truncate">@TruncateText(_replyingTo.Content, 60)</p>
                </div>
                <button class="p-1 ml-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none shrink-0"
                        @onclick="CancelReply">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    @if (_editingMessage is not null)
    {
        <div class="flex items-stretch px-4 pt-3">
            <div class="w-[3px] rounded-full bg-[var(--warning)] shrink-0"></div>
            <div class="flex-1 flex items-center justify-between px-3 py-2 rounded-r-[var(--radius-sm)] bg-[var(--bg-tertiary)]">
                <div class="min-w-0">
                    <p class="text-[11px] font-semibold text-[var(--warning)]">Editing message</p>
                </div>
                <button class="p-1 ml-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none shrink-0"
                        @onclick="CancelEdit">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    @if (_selectedFileName is not null)
    {
        <div class="flex items-center gap-2.5 mx-4 mt-2 p-3 rounded-[var(--radius-md)] bg-[var(--bg-tertiary)] border border-[var(--border)]">
            <span class="text-[20px]">📎</span>
            <div class="flex-1 min-w-0">
                <p class="text-[12px] font-semibold text-[var(--text-primary)] truncate">@_selectedFileName</p>
                <span class="text-[11px] text-[var(--text-muted)]">@FormatFileSize(_selectedFileSize)</span>
            </div>
            <button class="p-1 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    @onclick="CancelFileUpload">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
    }

    @if (_showEmojiPicker)
    {
        <EmojiPicker OnEmojiSelected="InsertEmoji" OnClose="() => _showEmojiPicker = false" />
    }

    <!-- Self-destruct toggle -->
    @if (_selfDestructEnabled)
    {
        <div class="flex items-center gap-3 mx-4 mt-2 px-3 py-2 rounded-[var(--radius-sm)] bg-[rgba(243,156,18,0.1)] border border-[rgba(243,156,18,0.3)]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="text-[12px] text-[var(--warning)] font-medium">Self-destruct: @_selfDestructSeconds s</span>
            <input type="range" min="5" max="300" step="5" @bind="_selfDestructSeconds"
                   class="flex-1 h-1 accent-[var(--warning)]" />
            <button class="p-1 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    @onclick="() => _selfDestructEnabled = false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
    }

    <!-- Voice recording bar -->
    @if (_isRecording)
    {
        <div class="flex items-center gap-2.5 mx-4 mt-2 px-3 py-2 rounded-[var(--radius-md)] bg-[var(--bg-tertiary)]">
            <div class="w-2 h-2 rounded-full bg-[var(--danger)]" style="animation: pulseDot 1s infinite;"></div>
            <span class="text-[13px] text-[var(--danger)] font-medium">Recording</span>
            <span class="text-[13px] text-[var(--text-secondary)]" style="font-family: var(--font-mono);">@FormatDuration(_recordingElapsed)</span>
            <div class="flex-1"></div>
            <button class="p-1.5 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none text-[var(--text-muted)]"
                    title="Cancel" @onclick="CancelVoiceRecording">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
            <button class="p-1.5 rounded-full bg-[var(--accent-glow)] text-[var(--accent)] transition-colors cursor-pointer border-none"
                    title="Send voice" @onclick="StopVoiceRecording">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M14 2L6 10M14 2l-4 12-2-5-5-2 11-7z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    }

    <!-- Input Container (matches Next.js ChatInput) -->
    <div class="flex items-end gap-2 p-3">
        <div class="flex items-center gap-0.5">
            <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    title="Emoji" @onclick="() => _showEmojiPicker = !_showEmojiPicker">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                    <line x1="9" y1="9" x2="9.01" y2="9"/>
                    <line x1="15" y1="9" x2="15.01" y2="9"/>
                </svg>
            </button>

            <label class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none inline-flex items-center justify-center"
                   title="Attach file">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
                <InputFile OnChange="HandleFileSelected" style="display: none;" accept="*/*" />
            </label>

            <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    style="@(_selfDestructEnabled ? "color: var(--warning);" : "")"
                    title="Self-destruct timer" @onclick="() => _selfDestructEnabled = !_selfDestructEnabled">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@(_selfDestructEnabled ? "var(--warning)" : "var(--text-secondary)")" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
            </button>

            <button class="p-2 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    style="@(_isRecording ? "color: var(--danger);" : "")"
                    title="Voice message" @onclick="StartVoiceRecording" disabled="@_isRecording">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="22"/>
                </svg>
            </button>
        </div>

        <div class="flex-1 flex items-end rounded-[var(--radius-lg)] bg-[var(--bg-tertiary)] border border-[var(--border)] focus-within:border-[var(--accent)] focus-within:shadow-[0_0_0_3px_var(--accent-glow)] transition-all duration-200 px-3 py-2">
            <textarea class="flex-1 bg-transparent text-[13px] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none resize-none leading-relaxed"
                      rows="1" placeholder="Type a message..." style="max-height: 120px;"
                      @bind="_messageText" @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      @onpaste="HandlePaste"></textarea>
        </div>

        <button class="p-2.5 rounded-full bg-[var(--accent)] text-[#fff] transition-all duration-200 cursor-pointer border-none disabled:opacity-30 disabled:cursor-not-allowed hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] shrink-0"
                @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(_messageText) && _selectedFileData is null)"
                title="Send (Enter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
        </button>
    </div>
</div>

@* ── Bookmarks Panel ── *@
@if (_showBookmarks)
{
    <div class="fixed top-0 right-0 w-[340px] h-full z-[900] bg-[var(--bg-secondary)] border-l border-[var(--border)] flex flex-col"
         style="box-shadow: var(--shadow-lg); animation: slideInRight 250ms ease;">
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border)]">
            <h3 class="text-[15px] font-semibold text-[var(--text-primary)]">@L("Bookmarks")</h3>
            <button class="p-1.5 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                    @onclick="() => _showBookmarks = false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <!-- Bookmark List -->
        <div class="flex-1 overflow-y-auto">
            @if (_bookmarks.Count == 0)
            {
                <div class="text-center text-[var(--text-muted)] text-[13px] py-6">
                    @L("NoBookmarks")
                </div>
            }
            else
            {
                @foreach (var bm in _bookmarks)
                {
                    <div class="px-4 py-3 border-b border-[var(--border)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer">
                        <p class="text-[13px] text-[var(--text-primary)] leading-relaxed">@TruncateText(bm.ContentPreview, 100)</p>
                        <div class="flex items-center gap-2 mt-1.5">
                            <span class="text-[11px] text-[var(--accent-light)]">@bm.SenderName</span>
                            <span class="text-[11px] text-[var(--text-muted)]">@bm.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- Room Info Dialog -->
@if (_showRoomInfo)
{
    <div class="fixed inset-0 z-[1000] flex items-center justify-center" @onclick="() => _showRoomInfo = false">
        <div class="absolute inset-0 bg-[rgba(0,0,0,0.7)]"></div>
        <div class="relative w-full max-w-[420px] rounded-[var(--radius-lg)] bg-[var(--bg-secondary)] border border-[var(--border)] p-6"
             style="box-shadow: var(--shadow-lg); animation: slideUp 250ms ease;"
             @onclick:stopPropagation="true">
            <h3 class="text-[16px] font-semibold text-[var(--text-primary)] mb-4">Room Information</h3>

            <div class="flex flex-col gap-4">
                <!-- Room ID -->
                <div class="flex flex-col gap-1">
                    <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Room ID</label>
                    <p class="text-[13px] font-mono text-[var(--text-secondary)] bg-[var(--bg-tertiary)] px-3 py-2 rounded-[var(--radius-sm)]" style="user-select: text;">@Room.Id</p>
                </div>

                @if (!string.IsNullOrEmpty(Room.Description))
                {
                    <div class="flex flex-col gap-1">
                        <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Description</label>
                        <p class="text-[13px] text-[var(--text-secondary)]">@Room.Description</p>
                    </div>
                }

                @if (Room.MaxCapacity > 0)
                {
                    <div class="flex flex-col gap-1">
                        <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Max Capacity</label>
                        <p class="text-[13px] text-[var(--text-secondary)]">@Room.MaxCapacity members</p>
                    </div>
                }

                @if (Room.InviteToken is not null)
                {
                    <div class="flex flex-col gap-1">
                        <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Invite Link</label>
                        <div class="flex items-center gap-2">
                            <p class="flex-1 text-[12px] font-mono text-[var(--text-secondary)] bg-[var(--bg-tertiary)] px-3 py-2 rounded-[var(--radius-sm)] truncate" style="user-select: text;">@Chat.GenerateInviteLink(Room)</p>
                            <button class="px-3 py-2 rounded-[var(--radius-sm)] bg-[var(--bg-tertiary)] border border-[var(--border)] text-[12px] text-[var(--text-secondary)] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors duration-200 whitespace-nowrap"
                                    @onclick="CopyInviteLink">@(_inviteCopied ? "Copied!" : "Copy")</button>
                        </div>
                    </div>
                }

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Encryption</label>
                    <span class="inline-flex w-fit items-center gap-1.5 px-2.5 py-1 rounded-[var(--radius-sm)] bg-[rgba(46,204,113,0.1)] text-[var(--success)] text-[12px]">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        AES-256-GCM + PBKDF2-SHA512 (600K iterations)
                    </span>
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-[11px] text-[var(--text-muted)] uppercase tracking-wider font-medium">Messages</label>
                    <p class="text-[13px] text-[var(--text-secondary)]">@_messages.Count</p>
                </div>

                <button class="w-full h-9 mt-2 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                        @onclick="() => _showRoomInfo = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ChatRoom Room { get; set; } = null!;
    [Parameter, EditorRequired] public string RoomPassword { get; set; } = string.Empty;

    private List<ChatMessage> _messages = [];
    private List<ChatMessage> _displayMessages = [];
    private List<ChatMessage> _pinnedMessages = [];
    private List<ChatMessage> _searchResults = [];
    private List<ChatRoom> _allRooms = [];
    private string _messageText = string.Empty;
    private bool _showRoomInfo;
    private bool _isDragOver;
    private bool _showEmojiPicker;
    private bool _showSearch;
    private bool _showForwardDialog;
    private bool _showContextMenu;
    private bool _showPinnedList;
    private bool _showBookmarks;
    private List<TordeX.Core.Models.Bookmark> _bookmarks = [];
    private bool _selfDestructEnabled;
    private int _selfDestructSeconds = 30;
    private string _searchQuery = string.Empty;
    private string? _fullscreenImage;
    private bool _inviteCopied;
    private double _contextMenuX, _contextMenuY;
    private ChatMessage? _contextMessage;
    private ElementReference _messagesContainer;

    // Reply/Edit state
    private ChatMessage? _replyingTo;
    private ChatMessage? _editingMessage;
    private ChatMessage? _forwardMessage;

    // File upload state
    private string? _selectedFileName;
    private long _selectedFileSize;
    private byte[]? _selectedFileData;
    private string? _selectedFileMimeType;

    // Image cache (fileId -> data:uri)
    private readonly Dictionary<string, string> _imageCache = new();

    // Reactions
    private ChatMessage? _reactionPickerTarget;
    private static readonly string[] _quickReactions = ["👍", "❤️", "😂", "😮", "😢", "🔥", "👎", "🎉"];

    // Voice recording state
    private bool _isRecording;
    private double _recordingElapsed;
    private DotNetObjectReference<ChatView>? _audioRef;

    // Voice playback
    private string? _playingMessageId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMessages();
        _allRooms = await Chat.GetRoomsAsync();
        _bookmarks = await Chat.GetBookmarksAsync();
    }

    protected override void OnInitialized()
    {
        Chat.OnMessageReceived += HandleIncomingMessage;
    }

    private void HandleIncomingMessage(ChatMessage msg)
    {
        if (msg.RoomId != Room.Id) return;

        InvokeAsync(() =>
        {
            // Avoid duplicates
            if (_messages.Any(m => m.Id == msg.Id)) return;

            _messages.Add(msg);
            _displayMessages = _messages;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Chat.OnMessageReceived -= HandleIncomingMessage;
        _audioRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('chat-messages')?.scrollTo(0, document.getElementById('chat-messages')?.scrollHeight ?? 0)");
        }
        catch { }
    }

    private async Task LoadMessages()
    {
        try
        {
            _messages = await Chat.GetMessagesAsync(Room.Id);
            _pinnedMessages = _messages.Where(m => m.IsPinned && !m.IsDeleted).ToList();
            _displayMessages = _messages;
        }
        catch
        {
            _messages = [];
            _displayMessages = [];
        }
    }

    // ──── Sending ────

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
        else if (e.Key == "Escape")
        {
            CancelReply();
            CancelEdit();
        }
    }

    private async Task SendMessage()
    {
        Chat.ResetActivityTimer();

        if (_selectedFileData is not null && _selectedFileName is not null)
        {
            try
            {
                var message = await Chat.SendFileMessageAsync(
                    Room.Id, _selectedFileName, _selectedFileData,
                    _selectedFileMimeType ?? "application/octet-stream");
                _messages.Add(message);
            }
            catch (Exception ex) { AddSystemMessage($"Failed to send file: {ex.Message}"); }
            CancelFileUpload();
        }

        if (!string.IsNullOrWhiteSpace(_messageText))
        {
            var text = _messageText.Trim();
            _messageText = string.Empty;

            if (_editingMessage is not null)
            {
                try
                {
                    await Chat.EditMessageAsync(Room.Id, _editingMessage.Id, text);
                    _editingMessage.Content = text;
                    _editingMessage.EditedAt = DateTimeOffset.UtcNow;
                }
                catch (Exception ex) { AddSystemMessage($"Edit failed: {ex.Message}"); }
                CancelEdit();
            }
            else
            {
                try
                {
                    var message = await Chat.SendTextMessageAsync(
                        Room.Id, text,
                        replyToId: _replyingTo?.Id,
                        replyToContent: _replyingTo is not null ? TruncateText(_replyingTo.Content, 100) : null,
                        replyToSenderName: _replyingTo?.SenderDisplayName,
                        selfDestructSeconds: _selfDestructEnabled ? _selfDestructSeconds : null);
                    _messages.Add(message);
                }
                catch (Exception ex) { AddSystemMessage($"Failed to send: {ex.Message}"); }
                CancelReply();
            }
        }

        _displayMessages = _messages;
        StateHasChanged();
    }

    // ──── Reply/Edit/Delete/Forward/Pin ────

    private void StartReply(ChatMessage msg)
    {
        _replyingTo = msg;
        _editingMessage = null;
        StateHasChanged();
    }

    private void CancelReply() { _replyingTo = null; StateHasChanged(); }

    private void StartEdit(ChatMessage msg)
    {
        _editingMessage = msg;
        _messageText = msg.Content;
        _replyingTo = null;
        StateHasChanged();
    }

    private void CancelEdit() { _editingMessage = null; StateHasChanged(); }

    private async Task DeleteMessage(ChatMessage msg)
    {
        try
        {
            await Chat.DeleteMessageAsync(msg.Id);
            msg.IsDeleted = true;
            StateHasChanged();
        }
        catch (Exception ex) { AddSystemMessage($"Delete failed: {ex.Message}"); }
    }

    private void StartForward(ChatMessage msg)
    {
        _forwardMessage = msg;
        _showForwardDialog = true;
        StateHasChanged();
    }

    private async Task ForwardToRoom(ChatRoom targetRoom)
    {
        if (_forwardMessage is null) return;
        try
        {
            await Chat.ForwardMessageAsync(targetRoom.Id, _forwardMessage);
            AddSystemMessage($"Message forwarded to {targetRoom.Name}");
        }
        catch (Exception ex) { AddSystemMessage($"Forward failed: {ex.Message}"); }
        _showForwardDialog = false;
        _forwardMessage = null;
        StateHasChanged();
    }

    private async Task TogglePin(ChatMessage msg)
    {
        try
        {
            if (msg.IsPinned)
            {
                await Chat.UnpinMessageAsync(msg.Id);
                msg.IsPinned = false;
                _pinnedMessages.Remove(msg);
            }
            else
            {
                await Chat.PinMessageAsync(msg.Id, Room.Id);
                msg.IsPinned = true;
                _pinnedMessages.Add(msg);
            }
            StateHasChanged();
        }
        catch (Exception ex) { AddSystemMessage($"Pin failed: {ex.Message}"); }
    }

    private async Task BlockSender(ChatMessage msg)
    {
        try
        {
            await Chat.BlockUserAsync(msg.SenderFingerprint, msg.SenderDisplayName);
            AddSystemMessage($"User {msg.SenderDisplayName} blocked.");
            StateHasChanged();
        }
        catch (Exception ex) { AddSystemMessage($"Block failed: {ex.Message}"); }
    }

    private async Task CopyMessage(ChatMessage msg)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", msg.Content);
        }
        catch { }
    }

    // ──── Context Menu ────

    private void ShowContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, ChatMessage msg)
    {
        _contextMessage = msg;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
        StateHasChanged();
    }

    private void CloseContextMenu() { _showContextMenu = false; StateHasChanged(); }

    // ──── Search ────

    private async Task HandleSearchKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults = await Chat.SearchMessagesAsync(Room.Id, _searchQuery);
            _displayMessages = _searchResults.Count > 0 ? _searchResults : _messages;
            StateHasChanged();
        }
        else if (e.Key == "Escape") CloseSearch();
    }

    private void CloseSearch()
    {
        _showSearch = false;
        _searchQuery = string.Empty;
        _searchResults = [];
        _displayMessages = _messages;
        StateHasChanged();
    }

    // ──── Emoji ────

    private void InsertEmoji(string emoji)
    {
        _messageText += emoji;
        StateHasChanged();
    }

    // ──── File Upload ────

    private async Task HandleFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long maxSize = 50 * 1024 * 1024;
        if (file.Size > maxSize) { AddSystemMessage("File too large. Maximum 50 MB."); return; }

        _selectedFileName = file.Name;
        _selectedFileSize = file.Size;
        _selectedFileMimeType = file.ContentType;

        using var stream = file.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _selectedFileData = ms.ToArray();
        StateHasChanged();
    }

    private void CancelFileUpload()
    {
        _selectedFileName = null;
        _selectedFileSize = 0;
        _selectedFileData = null;
        _selectedFileMimeType = null;
        StateHasChanged();
    }

    // ──── Drag & Drop ────

    private void HandleDragEnter() => _isDragOver = true;
    private void HandleDragLeave() => _isDragOver = false;
    private void HandleDrop() => _isDragOver = false;

    // ──── Clipboard Paste ────

    private Task HandlePaste(Microsoft.AspNetCore.Components.Web.ClipboardEventArgs e)
    {
        // Clipboard image paste is handled via JS interop
        // Basic text paste is handled natively by the textarea
        return Task.CompletedTask;
    }

    // ──── Image Preview ────

    private async Task LoadImagePreview(ChatMessage msg)
    {
        try
        {
            var data = await Chat.GetFileAsync(msg.Content, Room.Id, msg.FileName);
            if (data is not null)
            {
                var mime = msg.MimeType ?? "image/png";
                var base64 = Convert.ToBase64String(data);
                _imageCache[msg.Content] = $"data:{mime};base64,{base64}";
                StateHasChanged();
            }
        }
        catch { }
    }

    private void ShowImageFullscreen(string src) => _fullscreenImage = src;

    // ──── Voice Recording ────

    private async Task StartVoiceRecording()
    {
        _audioRef ??= DotNetObjectReference.Create(this);
        var success = await JS.InvokeAsync<bool>("tordeXAudio.startRecording", _audioRef);
        if (success)
        {
            _isRecording = true;
            _recordingElapsed = 0;
            StateHasChanged();
        }
    }

    private async Task StopVoiceRecording()
    {
        if (!_isRecording) return;
        _isRecording = false;
        await JS.InvokeVoidAsync("tordeXAudio.stopRecording");
        StateHasChanged();
    }

    private async Task CancelVoiceRecording()
    {
        if (!_isRecording) return;
        _isRecording = false;
        _recordingElapsed = 0;
        await JS.InvokeVoidAsync("tordeXAudio.cancelRecording");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRecordingTick(double elapsed)
    {
        _recordingElapsed = elapsed;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnRecordingComplete(string base64Audio, double duration)
    {
        try
        {
            var audioBytes = Convert.FromBase64String(base64Audio);
            var message = await Chat.SendVoiceMessageAsync(Room.Id, audioBytes, duration);
            _messages.Add(message);
            _displayMessages = _messages;
        }
        catch (Exception ex)
        {
            AddSystemMessage($"Voice send failed: {ex.Message}");
        }
        _recordingElapsed = 0;
        await InvokeAsync(StateHasChanged);
    }

    // ──── Voice Playback ────

    private async Task PlayVoice(ChatMessage msg)
    {
        Chat.ResetActivityTimer();
        var fileData = await Chat.GetFileAsync(msg.Content, msg.RoomId, msg.FileName);
        if (fileData is null) return;

        var base64 = Convert.ToBase64String(fileData);
        _audioRef ??= DotNetObjectReference.Create(this);
        _playingMessageId = msg.Id;
        StateHasChanged();
        await JS.InvokeAsync<bool>("tordeXAudio.playAudio", msg.Id, base64, _audioRef);
    }

    [JSInvokable]
    public void OnPlaybackEnded(string messageId)
    {
        if (_playingMessageId == messageId)
            _playingMessageId = null;
        InvokeAsync(StateHasChanged);
    }

    // ──── Room Info ────

    private void ToggleRoomInfo() => _showRoomInfo = !_showRoomInfo;

