<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TordeX.Desktop</RootNamespace>
    <AssemblyName>tordeX</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor Hybrid in WPF (WebView2) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.10" />

    <!-- Windows Community Toolkit for notifications -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />

    <!-- Hardcodet NotifyIcon for system tray -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tordeX.Core\tordeX.Core.csproj" />
    <ProjectReference Include="..\tordeX.UI\tordeX.UI.csproj" />
  </ItemGroup>

  <!-- Embedded Tor binary from Core project — must be alongside published EXE -->
  <ItemGroup>
    <Content Include="..\tordeX.Core\tor.exe" Condition="Exists('..\tordeX.Core\tor.exe')">
      <Link>tor.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy tor.exe alongside published EXE after publish (single-file bundles Content, so we force-copy) -->
  <Target Name="CopyTorAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\tordeX.Core\tor.exe"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('..\tordeX.Core\tor.exe')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied tor.exe to $(PublishDir)" />
  </Target>

</Project>
