                <div class="security-toggle" style="flex-direction: column; align-items: stretch; gap: 8px;">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("GuardPinning")</div>
                        <div class="security-toggle-desc">@L("GuardPinningDesc")</div>
                    </div>
                    <input type="text" class="form-input bridge-input" placeholder="$FINGERPRINT1,$FINGERPRINT2,..."
                           @bind="_secGuardNodes" style="font-size: 11px;" />
                </div>
            </div>

            <div class="settings-section">
                <div class="settings-section-title">@L("DataProtection")</div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("RamOnlyMode")</div>
                        <div class="security-toggle-desc">@L("RamOnlyModeDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secRamOnly" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                @if (_secRamOnly)
                {
                    <div class="ram-only-warning">
                        ⚠ Messages will be lost when you close the app
                    </div>
                }

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("AutoMetadataStrip")</div>
                        <div class="security-toggle-desc">@L("AutoMetadataStripDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secAutoMeta" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("MemoryProtection")</div>
                        <div class="security-toggle-desc">@L("MemoryProtectionDesc")</div>
                    </div>
                    <span class="security-badge active">DPAPI</span>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("SecureWipe")</div>
                        <div class="security-toggle-desc">@L("SecureWipeDesc")</div>
                    </div>
                    <span class="security-badge active">DoD 5220</span>
                </div>

                <!-- Dead Man's Switch -->
                <div class="security-toggle" style="flex-direction: column; align-items: stretch; gap: 8px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                        <div class="security-toggle-info">
                            <div class="security-toggle-label">@L("DeadManSwitch")</div>
                            <div class="security-toggle-desc">@L("DeadManSwitchDesc")</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="_secDeadMan" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    @if (_secDeadMan)
                    {
                        <div class="dead-man-config">
                            <div class="dead-man-days">
                                @L("DeadManSwitchDays"):
                                <input type="number" min="1" max="365" @bind="_secDeadManDays" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="settings-section">
                <div class="settings-section-title">@L("ThreatMonitoring")</div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("TamperDetection")</div>
                        <div class="security-toggle-desc">@L("TamperDetectionDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secTamper" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("IntegrityMonitoring")</div>
                        <div class="security-toggle-desc">@L("IntegrityMonitoringDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secIntegrity" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("CanaryTokens")</div>
                        <div class="security-toggle-desc">@L("CanaryTokensDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secCanary" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("BruteForceProtection")</div>
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="number" min="3" max="20" @bind="_secMaxAttempts" style="width: 50px; padding: 4px 6px; background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-primary); font-size: 12px; text-align: center;" />
                        <span style="font-size: 11px; color: var(--text-muted);">@L("MaxLoginAttempts")</span>
                    </div>
                </div>
            </div>

            <!-- Change Password Section -->
            <div class="settings-section">
                <div class="settings-section-title">@L("ChangePassword")</div>
                @if (!_showPasswordChange)
                {
                    <button class="btn-secondary" style="width: 100%; margin-top: 0;" @onclick="() => _showPasswordChange = true">
                        @L("ChangePassword")
                    </button>
                }
                else
                {
                    <div class="password-change-form">
                        <div class="form-group">
                            <label class="form-label">@L("CurrentPassword")</label>
                            <input type="password" class="form-input" @bind="_pwdCurrent" @bind:event="oninput" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L("NewPassword")</label>
                            <input type="password" class="form-input" @bind="_pwdNew" @bind:event="oninput" />
                            @{ var strength = GetPasswordStrength(_pwdNew); }
                            <div class="password-strength">
                                <div class="password-strength-bar @(strength >= 1 ? $"filled {GetStrengthClass(strength)}" : "")"></div>
                                <div class="password-strength-bar @(strength >= 2 ? $"filled {GetStrengthClass(strength)}" : "")"></div>
                                <div class="password-strength-bar @(strength >= 3 ? $"filled {GetStrengthClass(strength)}" : "")"></div>
                                <div class="password-strength-bar @(strength >= 4 ? $"filled {GetStrengthClass(strength)}" : "")"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">@L("ConfirmNewPassword")</label>
                            <input type="password" class="form-input" @bind="_pwdConfirm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_pwdConfirm))
                            {
                                <div class="password-match-indicator @(_pwdNew == _pwdConfirm ? "match" : "no-match")">
                                    @(_pwdNew == _pwdConfirm ? "Passwords match" : "Passwords do not match")
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_pwdError))
                        {
                            <div class="form-error">@_pwdError</div>
                        }
                        @if (!string.IsNullOrEmpty(_pwdSuccess))
                        {
                            <div style="font-size: 12px; color: var(--success);">@_pwdSuccess</div>
                        }
                        <div style="display: flex; gap: 8px;">
                            <button class="btn-primary" style="flex: 1;" @onclick="ChangePassword" disabled="@_pwdLoading">
                                @(_pwdLoading ? "Changing..." : L("Save"))
                            </button>
                            <button class="btn-secondary" style="flex: 1; margin-top: 0;" @onclick="() => _showPasswordChange = false">
                                @L("Cancel")
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Blocked Users Section -->
            <div class="settings-section">
                <div class="settings-section-title">@L("BlockedUsers")</div>
                @if (_blockedUsers.Count == 0)
                {
                    <div style="font-size: 13px; color: var(--text-muted); padding: 8px 0;">
                        @L("NoBlockedUsers")
                    </div>
                }
                else
                {
                    @foreach (var blocked in _blockedUsers)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border);">
                            <div>
                                <div style="font-size: 13px; color: var(--text-primary);">@(blocked.DisplayName ?? "Unknown")</div>
                                <div style="font-size: 11px; color: var(--text-muted); font-family: var(--font-mono);">@blocked.Fingerprint[..16]...</div>
                            </div>
                            <button class="btn-secondary" style="padding: 4px 12px; font-size: 12px; margin-top: 0;" @onclick="() => UnblockUser(blocked.Fingerprint)">
                                @L("Unblock")
                            </button>
                        </div>
                    }
                }
            </div>

            <!-- Panic Button Section -->
            <div class="settings-section">
                <div class="settings-section-title" style="color: var(--danger);">@L("PanicButton")</div>
                @if (!_showPanicConfirm)
                {
                    <button class="btn-panic" @onclick="() => _showPanicConfirm = true">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                            <path d="M9 2L2 16h14L9 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            <path d="M9 7v4M9 13v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        @L("DeleteAllData")
                    </button>
                }
                else
                {
                    <div style="padding: 16px; background: rgba(231, 76, 60, 0.1); border: 1px solid var(--danger); border-radius: var(--radius-md);">
                        <p style="font-size: 14px; color: var(--danger); font-weight: 600; margin-bottom: 8px;">
                            @L("CannotBeUndone")
                        </p>
                        <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">
                            All messages, rooms, keys, and profile data will be permanently destroyed.
                        </p>
                        <div class="panic-confirm-actions">
                            <button class="btn-panic" @onclick="ExecutePanicWipe" disabled="@_panicLoading">
                                @(_panicLoading ? "WIPING..." : "CONFIRM WIPE")
                            </button>
                            <button class="btn-secondary" @onclick="() => _showPanicConfirm = false">
                                @L("Cancel")
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_settingsError))
            {
                <div class="form-error">@_settingsError</div>
            }
            @if (!string.IsNullOrEmpty(_settingsSuccess))
            {
                <div style="font-size: 12px; color: var(--success); margin-top: 4px;">@_settingsSuccess</div>
            }
            </div>
            <!-- Fixed Footer -->
            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 12px 24px; border-top: 1px solid var(--border); flex-shrink: 0;">
                <button class="btn-secondary" style="width: auto; padding: 8px 16px; margin-top: 0;" @onclick="CloseDialogs">@L("Close")</button>
                <button class="btn-primary" style="width: auto; padding: 8px 20px; margin-top: 0;" @onclick="SaveSettings">@L("Save")</button>
            </div>
        </div>
    </div>
}

<!-- Panic Wipe Full-Screen Overlay -->
@if (_panicWiping)
{
    <div class="panic-confirm-overlay">
        <div class="panic-confirm-dialog">
            <h3>WIPING ALL DATA...</h3>
            <p>Securely overwriting and deleting all files. Do not close the application.</p>
        </div>
    </div>
}

@code {
    private List<ChatRoom> _rooms = [];
    private ChatRoom? _selectedRoom;
    private string _selectedRoomId = string.Empty;
    private string _selectedRoomPassword = string.Empty;

    // Dialog state
    private bool _showCreateRoom;
    private bool _showJoinRoom;
    private bool _showRoomPassword;
    private bool _showDeleteConfirm;
    private bool _showSettings;
    private string _newRoomName = string.Empty;
    private string _newRoomPassword = string.Empty;
    private string _newRoomDescription = string.Empty;
    private int _newRoomCapacity;
    private string _joinInput = string.Empty;
    private string _joinRoomId = string.Empty;
    private string _joinRoomName = string.Empty;
    private string _joinRoomPassword = string.Empty;
    private string _joinInviteToken = string.Empty;
    private bool _inviteLinkDetected;
    private string _unlockPassword = string.Empty;
    private ChatRoom? _unlockRoomTarget;
    private ChatRoom? _deleteRoomTarget;
    private string _dialogError = string.Empty;
    private bool _dialogLoading;

    // Settings
    private string _settingsDisplayName = string.Empty;
    private string _settingsLanguage = "en";
    private int _settingsAutoLock;
    private bool _settingsNotifSounds = true;
    private bool _settingsScreenCapture;

    // Security settings fields
    private bool _secDoubleRatchet = true;
    private bool _secPostQuantum;
    private bool _secMultiLayer;
    private bool _secDeniable;
    private bool _secTrafficObf = true;
    private bool _secTiming = true;
    private bool _secDnsLeak = true;
    private bool _secCertPinning;
    private string? _secBridgeLine;
    private string? _secTransport;
    private string? _secGuardNodes;
    private bool _secRamOnly;
    private bool _secAutoMeta = true;
    private bool _secDeadMan;
    private int _secDeadManDays = 30;
    private bool _secTamper = true;
    private bool _secIntegrity = true;
    private bool _secCanary = true;
    private int _secMaxAttempts = 5;
    private string _settingsError = string.Empty;
    private string _settingsSuccess = string.Empty;

    // Password change
    private bool _showPasswordChange;
    private string _pwdCurrent = string.Empty;
    private string _pwdNew = string.Empty;
    private string _pwdConfirm = string.Empty;
    private string _pwdError = string.Empty;
    private string _pwdSuccess = string.Empty;
    private bool _pwdLoading;

    // Blocked users
    private List<BlockedUser> _blockedUsers = [];

    // Panic
    private bool _showPanicConfirm;
    private bool _panicLoading;
    private bool _panicWiping;

    // Tor
    private bool _torConnecting;
    private string? _torError;

    // Room passwords (in-memory only, never stored plaintext)
    private readonly Dictionary<string, string> _roomPasswords = new();

    // Localization helper
    private static string L(string key) => LocalizationService.T(key);

    private string GetTransportBtnClass(string transport) =>
        $"transport-btn{(_secTransport == transport ? " active" : "")}";

    private void ToggleTransport(string transport) =>
        _secTransport = _secTransport == transport ? null : transport;

    protected override async Task OnInitializedAsync()
    {
        _rooms = await Chat.GetRoomsAsync();
        LoadSettingsFromProfile();

        // Set language
        LocalizationService.CurrentLanguage = _settingsLanguage;

        // Listen for auto-update state changes
        Updater.OnStateChanged += OnUpdaterStateChanged;

        // Auto-connect to Tor in background
        if (!Chat.IsTorConnected)
        {
            _ = AutoConnectTorAsync();
        }

        // Check for updates in background
        _ = Updater.CheckForUpdateAsync();
    }

    private async Task AutoConnectTorAsync()
    {
        _torConnecting = true;
        _torError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Chat.StartTorAsync();
        }
        catch (Exception ex)
        {
            _torError = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Auto Tor connection failed: {ex.Message}");
        }
        finally
        {
            _torConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ──────── Room Selection ────────

    private void SelectRoom(ChatRoom room)
    {
        Chat.ResetActivityTimer();

        if (!_roomPasswords.TryGetValue(room.Id, out var password))
        {
            _unlockRoomTarget = room;
            _unlockPassword = string.Empty;
            _dialogError = string.Empty;
            _showRoomPassword = true;
            return;
        }

        ActivateRoom(room, password);
    }

    private void ActivateRoom(ChatRoom room, string password)
    {
        _selectedRoom = room;
        _selectedRoomId = room.Id;
        _selectedRoomPassword = password;
        Chat.UnlockRoom(room.Id, password, room.RoomSalt);
        StateHasChanged();
    }

    private async Task HandleUnlockKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await UnlockRoom();
    }

    private Task UnlockRoom()
    {
        _dialogError = string.Empty;

        if (string.IsNullOrWhiteSpace(_unlockPassword))
        {
            _dialogError = "Password is required.";
            return Task.CompletedTask;
        }

        if (_unlockRoomTarget is null) return Task.CompletedTask;

        _roomPasswords[_unlockRoomTarget.Id] = _unlockPassword;
        ActivateRoom(_unlockRoomTarget, _unlockPassword);
        _showRoomPassword = false;
        _unlockRoomTarget = null;
        return Task.CompletedTask;
    }

    // ──────── Room Context Menu ────────

    private void ShowRoomContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, ChatRoom room)
    {
        _deleteRoomTarget = room;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteRoom()
    {
        if (_deleteRoomTarget is null) return;

        try
        {
            await Chat.DeleteRoomAsync(_deleteRoomTarget.Id);
            _rooms.Remove(_deleteRoomTarget);
            _roomPasswords.Remove(_deleteRoomTarget.Id);

            if (_selectedRoomId == _deleteRoomTarget.Id)
            {
                _selectedRoom = null;
                _selectedRoomId = string.Empty;
            }
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }

        _deleteRoomTarget = null;
        _showDeleteConfirm = false;
        StateHasChanged();
    }

    // ──────── Tor ────────

    private async Task ConnectTor()
    {
        _torConnecting = true;
        _torError = null;
        StateHasChanged();

        try
        {
            await Chat.StartTorAsync();
        }
        catch (Exception ex)
        {
            _torError = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Tor connection failed: {ex.Message}");
        }
        finally
        {
            _torConnecting = false;
            StateHasChanged();
        }
    }

    // ──────── Dialogs ────────

    private void ShowCreateRoomDialog()
    {
        CloseDialogs();
        _showCreateRoom = true;
        _dialogError = string.Empty;
        _newRoomName = string.Empty;
        _newRoomPassword = string.Empty;
        _newRoomDescription = string.Empty;
        _newRoomCapacity = 0;
    }

    private void ShowJoinRoomDialog()
    {
        CloseDialogs();
        _showJoinRoom = true;
        _dialogError = string.Empty;
        _joinInput = string.Empty;
        _joinRoomId = string.Empty;
        _joinRoomName = string.Empty;
        _joinRoomPassword = string.Empty;
        _joinInviteToken = string.Empty;
        _inviteLinkDetected = false;
    }

    private void CloseDialogs()
    {
        _showCreateRoom = false;
        _showJoinRoom = false;
        _showRoomPassword = false;
        _showDeleteConfirm = false;
        _showSettings = false;
        _dialogError = string.Empty;
        _settingsError = string.Empty;
        _settingsSuccess = string.Empty;
        _showPasswordChange = false;
        _showPanicConfirm = false;
        _pwdError = string.Empty;
        _pwdSuccess = string.Empty;
        _pwdCurrent = string.Empty;
        _pwdNew = string.Empty;
        _pwdConfirm = string.Empty;
    }

    // ──────── Create / Join ────────

    private async Task CreateRoom()
    {
        _dialogError = string.Empty;

        if (string.IsNullOrWhiteSpace(_newRoomName))
        {
            _dialogError = "Room name is required.";
            return;
        }

        if (_newRoomPassword.Length < 6)
        {
            _dialogError = "Room password must be at least 6 characters.";
            return;
        }

        _dialogLoading = true;
        StateHasChanged();

        try
        {
            var room = await Chat.CreateRoomAsync(
                _newRoomName, _newRoomPassword,
                string.IsNullOrWhiteSpace(_newRoomDescription) ? null : _newRoomDescription,
                _newRoomCapacity);
            _rooms.Insert(0, room);
            _roomPasswords[room.Id] = _newRoomPassword;
            ActivateRoom(room, _newRoomPassword);
            _showCreateRoom = false;
        }
        catch (Exception ex)
        {
            _dialogError = $"Failed: {ex.Message}";
        }
        finally
        {
            _dialogLoading = false;
            StateHasChanged();
        }
    }

    private async Task JoinRoom()
    {
        _dialogError = string.Empty;

        // Parse smart input: invite link or plain room ID
        var roomId = _joinRoomId;
        if (!_inviteLinkDetected)
        {
            // User typed plain text — treat as room ID directly
            roomId = _joinInput.Trim();
        }

        if (string.IsNullOrWhiteSpace(roomId))
        {
            _dialogError = "Room ID is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_joinRoomPassword))
        {
            _dialogError = "Room password is required.";
            return;
        }

        _dialogLoading = true;
        StateHasChanged();

        try
        {
            var saltInput = System.Text.Encoding.UTF8.GetBytes($"tordeX-room-salt-v1:{roomId}");
            var roomSalt = System.Security.Cryptography.SHA256.HashData(saltInput);

            var name = string.IsNullOrWhiteSpace(_joinRoomName) ? "Room " + roomId[..Math.Min(8, roomId.Length)] : _joinRoomName;
            var room = await Chat.JoinRoomAsync(roomId, name, _joinRoomPassword, roomSalt);
            _rooms.Insert(0, room);
            _roomPasswords[room.Id] = _joinRoomPassword;
            ActivateRoom(room, _joinRoomPassword);
            _showJoinRoom = false;
        }
        catch (Exception ex)
        {
            _dialogError = $"Failed: {ex.Message}";
        }
        finally
        {
            _dialogLoading = false;
            StateHasChanged();
        }
    }

    // ──────── Settings ────────

    private async void OpenSettings()
    {
        CloseDialogs();
        _showSettings = true;
        LoadSettingsFromProfile();

        try
        {
            _blockedUsers = await Chat.GetBlockedUsersAsync();
        }
        catch
        {
            _blockedUsers = [];
        }

        StateHasChanged();
    }

    private void OnLanguageChanged(ChangeEventArgs e)
    {
        _settingsLanguage = e.Value?.ToString() ?? "en";
        LocalizationService.CurrentLanguage = _settingsLanguage;
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        _settingsError = string.Empty;
        _settingsSuccess = string.Empty;

        if (string.IsNullOrWhiteSpace(_settingsDisplayName))
        {
            _settingsError = "Display name cannot be empty.";
            return;
        }

        try
        {
            if (Chat.CurrentUser is not null)
            {
                Chat.CurrentUser.DisplayName = _settingsDisplayName.Trim();
                Chat.CurrentUser.Language = _settingsLanguage;
                Chat.CurrentUser.AutoLockMinutes = _settingsAutoLock;
                Chat.CurrentUser.NotificationSounds = _settingsNotifSounds;
                Chat.CurrentUser.ScreenCaptureProtection = _settingsScreenCapture;
                Chat.CurrentUser.DoubleRatchetEnabled = _secDoubleRatchet;
                Chat.CurrentUser.PostQuantumEnabled = _secPostQuantum;
                Chat.CurrentUser.MultiLayerEncryption = _secMultiLayer;
                Chat.CurrentUser.DeniableEncryption = _secDeniable;
                Chat.CurrentUser.TrafficObfuscation = _secTrafficObf;
                Chat.CurrentUser.TimingProtection = _secTiming;
                Chat.CurrentUser.DnsLeakProtection = _secDnsLeak;
                Chat.CurrentUser.RamOnlyMode = _secRamOnly;
                Chat.CurrentUser.AutoMetadataStrip = _secAutoMeta;
                Chat.CurrentUser.DeadManSwitch = _secDeadMan;
                Chat.CurrentUser.DeadManSwitchDays = _secDeadManDays;
                Chat.CurrentUser.TamperDetection = _secTamper;
                Chat.CurrentUser.IntegrityMonitoring = _secIntegrity;
                Chat.CurrentUser.CanaryTokens = _secCanary;
                Chat.CurrentUser.MaxLoginAttempts = _secMaxAttempts;
                Chat.CurrentUser.TorBridgeLine = _secBridgeLine;
                Chat.CurrentUser.TorPluggableTransport = _secTransport;
                Chat.CurrentUser.PinnedGuardNodes = _secGuardNodes;

                await Chat.UpdateProfileAsync();
            }

            // Apply screen capture protection immediately
            ApplyScreenCaptureProtection(_settingsScreenCapture);

            LocalizationService.CurrentLanguage = _settingsLanguage;

            _settingsSuccess = L("SettingsSaved");
            StateHasChanged();
            await Task.Delay(1500);
            _showSettings = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _settingsError = ex.Message;
        }
    }

