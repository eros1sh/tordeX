@using TordeX.Core.Models
@using TordeX.Core.Services
@inject ChatService Chat
@inject AutoUpdateService Updater

<!-- Update Banner -->
@if (Updater.UpdateAvailable && !Updater.UpdateDismissed)
{
    <div class="update-banner">
        <div class="update-banner-content">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="update-icon">
                <path d="M9 2v8M9 10l-3-3M9 10l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3 13v1a2 2 0 002 2h8a2 2 0 002-2v-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <div class="update-info">
                <span class="update-title">@L("UpdateAvailable")</span>
                <span class="update-versions">
                    <span class="update-version-old">@L("CurrentVersionLabel") @AutoUpdateService.CurrentVersion</span>
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align: middle;">
                        <path d="M4 6h4M6.5 4l2 2-2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="update-version-new">@L("NewVersionLabel") @Updater.LatestVersion</span>
                </span>
            </div>
            @if (Updater.IsDownloading)
            {
                <div class="update-progress-wrapper">
                    <div class="update-progress-bar">
                        <div class="update-progress-fill" style="width: @GetDownloadPercent()%"></div>
                    </div>
                    <span class="update-progress-text">@FormatBytes(Updater.DownloadedBytes) / @FormatBytes(Updater.DownloadTotalBytes)</span>
                </div>
            }
            else if (Updater.ErrorMessage is not null)
            {
                <span class="update-error">@Updater.ErrorMessage</span>
                <button class="btn-update" @onclick="DownloadUpdate">@L("UpdateNow")</button>
            }
            else
            {
                <button class="btn-update" @onclick="DownloadUpdate">@L("UpdateNow")</button>
            }
        </div>
        <button class="update-dismiss" @onclick="() => Updater.UpdateDismissed = true" title="@L("Close")">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    </div>
}

<div class="app-layout">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <img src="img/logo.png" alt="tordeX" />
            <h1>tordeX</h1>
            <div style="margin-left: auto;">
                <button class="btn-icon" title="@L("Settings")" @onclick="() => OpenSettings()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Tor Status Banner -->
        <div style="padding: 8px 12px; border-bottom: 1px solid var(--border);">
            @if (_torConnecting)
            {
                <div class="tor-status connecting" style="width: 100%; justify-content: center;">
                    <div class="status-dot connecting"></div>
                    @L("ConnectingToTor")
                </div>
            }
            else if (Chat.IsTorConnected)
            {
                <div class="tor-status connected" style="width: 100%; justify-content: center; background: rgba(46, 204, 113, 0.08); border-radius: var(--radius-sm); padding: 6px 10px;">
                    <span class="status-dot online" style="width: 8px; height: 8px; box-shadow: 0 0 6px var(--success);"></span>
                    @L("TorConnected")
                </div>
            }
            else if (_torError is not null)
            {
                <div style="display: flex; flex-direction: column; gap: 4px; align-items: center;">
                    <div class="tor-status" style="color: var(--danger); width: 100%; justify-content: center;">
                        <div class="status-dot offline"></div>
                        @L("TorFailed")
                    </div>
                    <button class="btn-tor-connect" style="font-size: 11px; padding: 4px 10px;" @onclick="ConnectTor">
                        @L("RetryConnection")
                    </button>
                </div>
            }
            else
            {
                <button class="btn-tor-connect" @onclick="ConnectTor">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1"/>
                        <circle cx="7" cy="7" r="0.5" fill="currentColor"/>
                    </svg>
                    @L("ConnectToTorNetwork")
                </button>
            }
        </div>

        <div class="sidebar-content">
            @if (_rooms.Count == 0)
            {
                <div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    <p>@L("NoRoomsYet")</p>
                    <p style="margin-top: 4px;">@L("CreateOrJoinRoom")</p>
                </div>
            }
            else
            {
                @foreach (var room in _rooms)
                {
                    <div class="room-item @(room.Id == _selectedRoomId ? "active" : "")"
                         @onclick="() => SelectRoom(room)"
                         @oncontextmenu="(e) => ShowRoomContextMenu(e, room)" @oncontextmenu:preventDefault="true">
                        <div class="room-icon">@(room.Name.Length > 0 ? room.Name[0].ToString().ToUpper() : "?")</div>
                        <div class="room-info">
                            <div class="room-name">@room.Name</div>
                            <div class="room-preview">
                                @if (_roomPasswords.ContainsKey(room.Id))
                                {
                                    <span class="encryption-badge">@L("Unlocked")</span>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: var(--text-muted);">
                                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" style="vertical-align: middle;">
                                            <rect x="1" y="4.5" width="8" height="5" rx="1" stroke="currentColor" stroke-width="1"/>
                                            <path d="M3 4.5V3a2 2 0 014 0v1.5" stroke="currentColor" stroke-width="1"/>
                                        </svg>
                                        @L("Locked")
                                    </span>
                                }
                            </div>
                        </div>
                        @if (room.UnreadCount > 0)
                        {
                            <span class="room-badge">@room.UnreadCount</span>
                        }
                    </div>
                }
            }
        </div>

        <div class="sidebar-actions">
            <button class="btn-new-room" @onclick="ShowCreateRoomDialog">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                @L("NewRoom")
            </button>
            <button class="btn-secondary" style="margin-top: 6px;" @onclick="ShowJoinRoomDialog">
                @L("JoinRoom")
            </button>
        </div>

        <div class="user-section">
            <div class="avatar avatar-sm" style="background: var(--accent-glow); color: var(--accent);" title="@Chat.CurrentUser?.DisplayName">
                @if (Chat.CurrentUser?.AvatarData is { Length: > 0 })
                {
                    <img src="data:image/png;base64,@Convert.ToBase64String(Chat.CurrentUser.AvatarData)" alt="avatar" />
                }
                else
                {
                    @(Chat.CurrentUser?.DisplayName.Length > 0 ? Chat.CurrentUser.DisplayName[0].ToString().ToUpper() : "?")
                }
            </div>
            <div style="min-width: 0; flex: 1;">
                <div class="user-name">@Chat.CurrentUser?.DisplayName</div>
                <div class="user-fingerprint">@Chat.UserFingerprint</div>
            </div>
            <button class="btn-icon" style="margin-left: 4px;" title="Lock" @onclick="LockApp">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <rect x="2" y="6" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M4.5 6V4.5a2.5 2.5 0 015 0V6" stroke="currentColor" stroke-width="1.2"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @if (_selectedRoom is not null && _roomPasswords.ContainsKey(_selectedRoom.Id))
        {
            <ChatView Room="_selectedRoom" RoomPassword="_selectedRoomPassword" />
        }
        else
        {
            <div class="empty-state">
                <img src="img/logo.png" alt="tordeX" style="width: 80px; height: 80px; opacity: 0.2;" />
                <h3>@L("WelcomeMessage")</h3>
                <p>@L("WelcomeSubtext")</p>
                <div style="margin-top: 16px; display: flex; gap: 8px;">
                    <button class="btn-primary" style="width: auto; padding: 10px 24px;" @onclick="ShowCreateRoomDialog">
                        @L("NewRoom")
                    </button>
                    <button class="btn-secondary" style="width: auto; padding: 10px 24px;" @onclick="ShowJoinRoomDialog">
                        @L("JoinRoom")
                    </button>
                </div>
            </div>
        }

        <div class="status-bar">
            <div style="display: flex; align-items: center; gap: 6px;">
                <span class="status-dot @(Chat.IsTorConnected ? "online" : "offline")" style="width: 6px; height: 6px;"></span>
                <span>Tor: @(Chat.IsTorConnected ? "Connected" : "Disconnected")</span>
            </div>
            <span style="margin-left: auto; display: flex; align-items: center; gap: 6px;">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span style="color: var(--success);">@L("EndToEndEncrypted")</span>
            </span>
        </div>
    </div>
</div>

<!-- Room Password Dialog -->
@if (_showRoomPassword)
{
    <div class="modal-backdrop" @onclick="CloseDialogs">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" style="vertical-align: middle; margin-right: 8px;">
                    <rect x="3" y="8" width="12" height="8" rx="2" stroke="var(--accent)" stroke-width="1.5"/>
                    <path d="M6 8V6a3 3 0 016 0v2" stroke="var(--accent)" stroke-width="1.5"/>
                </svg>
                @L("UnlockRoom")
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
                @L("EnterPasswordFor") <strong style="color: var(--text-primary);">@_unlockRoomTarget?.Name</strong>
            </p>

            <div class="form-group">
                <label class="form-label">@L("RoomPassword")</label>
                <input type="password" class="form-input" placeholder="@L("RoomPassword")"
                       @bind="_unlockPassword" @bind:event="oninput"
                       @onkeydown="HandleUnlockKeyDown" />
            </div>

            @if (!string.IsNullOrEmpty(_dialogError))
            {
                <div class="form-error">@_dialogError</div>
            }

            <button class="btn-primary" @onclick="UnlockRoom">@L("Unlock")</button>
            <button class="btn-secondary" @onclick="CloseDialogs">@L("Cancel")</button>
        </div>
    </div>
}

<!-- Create Room Dialog -->
@if (_showCreateRoom)
{
    <div class="modal-backdrop" @onclick="CloseDialogs">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">@L("CreateNewRoom")</div>

            <div class="form-group">
                <label class="form-label">@L("RoomName")</label>
                <input type="text" class="form-input" placeholder="My Secret Room"
                       @bind="_newRoomName" @bind:event="oninput" maxlength="64" />
            </div>

            <div class="form-group">
                <label class="form-label">@L("RoomDescription")</label>
                <input type="text" class="form-input" placeholder="Optional description..."
                       @bind="_newRoomDescription" @bind:event="oninput" maxlength="256" />
            </div>

            <div class="form-group">
                <label class="form-label">@L("RoomPassword")</label>
                <input type="password" class="form-input" placeholder="Strong shared password"
                       @bind="_newRoomPassword" @bind:event="oninput" />
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
                    @L("SharePasswordHint")
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">@L("MaxCapacity")</label>
                <input type="number" class="form-input" min="0" max="1000" placeholder="0 = unlimited"
                       @bind="_newRoomCapacity" @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrEmpty(_dialogError))
            {
                <div class="form-error">@_dialogError</div>
            }

            <button class="btn-primary" @onclick="CreateRoom" disabled="@_dialogLoading">
                @(_dialogLoading ? "Creating..." : L("CreateNewRoom"))
            </button>
            <button class="btn-secondary" @onclick="CloseDialogs">@L("Cancel")</button>
        </div>
    </div>
}

<!-- Join Room Dialog -->
@if (_showJoinRoom)
{
    <div class="modal-backdrop" @onclick="CloseDialogs">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">@L("JoinRoom")</div>

            <div class="form-group">
                <label class="form-label">@L("RoomIdOrInvite")</label>
                <input type="text" class="form-input" placeholder="@L("PasteRoomIdOrInvite")"
                       value="@_joinInput"
                       @oninput="OnJoinInputChanged" />
                @if (_inviteLinkDetected)
                {
                    <div class="invite-detected-badge">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2"/>
                            <path d="M4 6l1.5 1.5L8 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        @L("InviteLinkDetected")
                    </div>
                }
            </div>

            <div class="form-group">
                <label class="form-label">@L("RoomNameOptional")</label>
                <input type="text" class="form-input" placeholder="@L("RoomNameOptionalPlaceholder")"
                       @bind="_joinRoomName" @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label class="form-label">@L("RoomPassword")</label>
                <input type="password" class="form-input" placeholder="@L("RoomSharedPassword")"
                       @bind="_joinRoomPassword" @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrEmpty(_dialogError))
            {
                <div class="form-error">@_dialogError</div>
            }

            <button class="btn-primary" @onclick="JoinRoom" disabled="@_dialogLoading">
                @(_dialogLoading ? "Joining..." : L("JoinRoom"))
            </button>
            <button class="btn-secondary" @onclick="CloseDialogs">@L("Cancel")</button>
        </div>
    </div>
}

<!-- Delete Room Confirm -->
@if (_showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="CloseDialogs">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title" style="color: var(--danger);">@L("DeleteRoom")</div>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
                @L("ConfirmDeleteRoom") <strong style="color: var(--text-primary);">@_deleteRoomTarget?.Name</strong>?
                @L("PermanentDeleteWarning")
            </p>

            <button class="btn-primary" style="background: var(--danger);" @onclick="ConfirmDeleteRoom">
                @L("DeleteRoom")
            </button>
            <button class="btn-secondary" @onclick="CloseDialogs">@L("Cancel")</button>
        </div>
    </div>
}

<!-- Settings Dialog (Full Featured) -->
@if (_showSettings)
{
    <div class="modal-backdrop" @onclick="CloseDialogs">
        <div class="modal" style="max-width: 480px; max-height: 85vh; overflow: hidden; padding: 0; display: flex; flex-direction: column;" @onclick:stopPropagation="true">
            <!-- Fixed Header -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid var(--border); flex-shrink: 0;">
                <span class="modal-title" style="margin-bottom: 0;">@L("Settings")</span>
                <button class="btn-icon" style="width: 28px; height: 28px;" @onclick="CloseDialogs" title="@L("Close")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <!-- Scrollable Body -->
            <div style="flex: 1; overflow-y: auto; padding: 0 24px 24px;">

            <!-- Profile Section -->
            <div class="settings-section">
                <div class="settings-section-title">Profile</div>

                <div class="form-group">
                    <label class="form-label">@L("DisplayName")</label>
                    <input type="text" class="form-input" @bind="_settingsDisplayName" @bind:event="oninput" maxlength="32" />
                </div>

                <div class="form-group">
                    <label class="form-label">@L("YourFingerprint")</label>
                    <input type="text" class="form-input" value="@Chat.UserFingerprint" readonly
                           style="font-family: var(--font-mono); font-size: 12px; user-select: text;" />
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
                        @L("FingerprintDescription")
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">@L("PublicKey")</label>
                    <input type="text" class="form-input"
                           value="@(Chat.CurrentUser is not null ? Convert.ToBase64String(Chat.CurrentUser.PublicKey)[..40] + "..." : "")"
                           readonly style="font-family: var(--font-mono); font-size: 11px; user-select: text;" />
                </div>
            </div>

            <!-- Language Section -->
            <div class="settings-section">
                <div class="settings-section-title">@L("Language")</div>
                <div class="language-selector">
                    <select class="language-select" @onchange="OnLanguageChanged" value="@_settingsLanguage">
                        <option value="en">English</option>
                        <option value="tr">Turkce</option>
                    </select>
                </div>
            </div>

            <!-- Security Section -->
            <div class="settings-section">
                <div class="settings-section-title">@L("SecurityInfo")</div>

                <div style="font-size: 12px; color: var(--text-secondary); padding: 8px; background: var(--bg-tertiary); border-radius: var(--radius-md); margin-bottom: 12px;">
                    <div style="margin-bottom: 4px;"><strong>@L("Encryption"):</strong> AES-256-GCM</div>
                    <div style="margin-bottom: 4px;"><strong>@L("KeyDerivation"):</strong> PBKDF2-SHA512 (600K iterations)</div>
                    <div style="margin-bottom: 4px;"><strong>@L("KeyExchange"):</strong> ECDH P-256 + HKDF</div>
                    <div style="margin-bottom: 4px;"><strong>@L("Signatures"):</strong> ECDSA P-256</div>
                    <div><strong>@L("Network"):</strong> Tor SOCKS5 Onion Routing</div>
                </div>

                <!-- Auto-Lock -->
                <div class="settings-item">
                    <div class="settings-item-info">
                        <div class="settings-item-label">@L("AutoLock")</div>
                        <div class="settings-item-desc">
                            @if (_settingsAutoLock > 0)
                            {
                                @($"{_settingsAutoLock} {L("Minutes")}")
                            }
                            else
                            {
                                @L("Never")
                            }
                        </div>
                    </div>
                    <select class="language-select" style="width: 120px;" @bind="_settingsAutoLock">
                        <option value="0">@L("Never")</option>
                        <option value="1">1 min</option>
                        <option value="5">5 min</option>
                        <option value="15">15 min</option>
                        <option value="30">30 min</option>
                        <option value="60">60 min</option>
                    </select>
                </div>

                <!-- Notification Sounds -->
                <div class="settings-item">
                    <div class="settings-item-info">
                        <div class="settings-item-label">@L("NotificationSounds")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_settingsNotifSounds" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <!-- Screen Capture Protection -->
                <div class="settings-item">
                    <div class="settings-item-info">
                        <div class="settings-item-label">@L("ScreenCaptureProtection")</div>
                        <div class="settings-item-desc">Window appears black in screenshots</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_settingsScreenCapture" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>

            <!-- ═══════ SECURITY & PRIVACY DASHBOARD ═══════ -->
            <div class="settings-section">
                <div class="settings-section-title">@L("CryptoSettings")</div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("DoubleRatchet")</div>
                        <div class="security-toggle-desc">@L("DoubleRatchetDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secDoubleRatchet" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("PostQuantum")</div>
                        <div class="security-toggle-desc">@L("PostQuantumDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secPostQuantum" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("MultiLayerEncryption")</div>
                        <div class="security-toggle-desc">@L("MultiLayerEncryptionDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secMultiLayer" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("DeniableEncryption")</div>
                        <div class="security-toggle-desc">@L("DeniableEncryptionDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secDeniable" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>

            <div class="settings-section">
                <div class="settings-section-title">@L("NetworkSecurity")</div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("TrafficObfuscation")</div>
                        <div class="security-toggle-desc">@L("TrafficObfuscationDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secTrafficObf" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("TimingProtection")</div>
                        <div class="security-toggle-desc">@L("TimingProtectionDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secTiming" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("DnsLeakProtection")</div>
                        <div class="security-toggle-desc">@L("DnsLeakProtectionDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secDnsLeak" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="security-toggle">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("CertificatePinning")</div>
                        <div class="security-toggle-desc">@L("CertificatePinningDesc")</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="_secCertPinning" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <!-- Tor Bridge Config -->
                <div class="security-toggle" style="flex-direction: column; align-items: stretch; gap: 8px;">
                    <div class="security-toggle-info">
                        <div class="security-toggle-label">@L("TorBridge")</div>
                        <div class="security-toggle-desc">@L("TorBridgeDesc")</div>
                    </div>
                    <input type="text" class="form-input bridge-input" placeholder="obfs4 IP:PORT FINGERPRINT..."
                           @bind="_secBridgeLine" style="font-size: 11px;" />
                    <div class="transport-selector">
                        @{ var transports = new[] { "obfs4", "meek", "snowflake" }; }
