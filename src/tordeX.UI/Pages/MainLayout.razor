    // ──────── Password Change ────────

    private async Task ChangePassword()
    {
        _pwdError = string.Empty;
        _pwdSuccess = string.Empty;

        if (string.IsNullOrWhiteSpace(_pwdCurrent))
        {
            _pwdError = "Current password is required.";
            return;
        }
        if (_pwdNew.Length < 8)
        {
            _pwdError = L("PasswordMinLength");
            return;
        }
        if (_pwdNew != _pwdConfirm)
        {
            _pwdError = L("PasswordsDoNotMatch");
            return;
        }

        _pwdLoading = true;
        StateHasChanged();

        try
        {
            var ok = await Chat.ChangePasswordAsync(_pwdCurrent, _pwdNew);
            if (!ok)
            {
                _pwdError = L("InvalidPassword");
            }
            else
            {
                _pwdSuccess = L("PasswordChanged");
                _pwdCurrent = string.Empty;
                _pwdNew = string.Empty;
                _pwdConfirm = string.Empty;
                _showPasswordChange = false;
            }
        }
        catch (Exception ex)
        {
            _pwdError = ex.Message;
        }
        finally
        {
            _pwdLoading = false;
            StateHasChanged();
        }
    }

    private static int GetPasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) return 0;
        int score = 0;
        if (password.Length >= 8) score++;
        if (password.Length >= 12) score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(c => !char.IsLetterOrDigit(c))) score++;
        return score;
    }

