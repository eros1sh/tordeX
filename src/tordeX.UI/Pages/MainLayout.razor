@using TordeX.Core.Models
@using TordeX.Core.Services
@inject ChatService Chat
@inject AutoUpdateService Updater
@inject IPlatformService Platform
@implements IDisposable

<div class="flex flex-col h-screen w-screen overflow-hidden bg-[var(--bg-primary)]">

<!-- Update Banner -->
@if (Updater.UpdateAvailable && !Updater.UpdateDismissed)
{
    <div class="w-full shrink-0 flex items-center px-5 py-2.5 text-[#fff]"
         style="background: linear-gradient(135deg, var(--accent-dark), var(--accent), #7d3f99); animation: slideDown 350ms ease;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <div class="ml-3 flex flex-col">
            <span class="text-[13px] font-semibold">@L("UpdateAvailable")</span>
            <span class="text-[11px] opacity-70">@L("CurrentVersionLabel") @AutoUpdateService.CurrentVersion → @L("NewVersionLabel") @Updater.LatestVersion</span>
        </div>
        <div class="ml-auto flex items-center gap-3">
            @if (Updater.IsDownloading)
            {
                <div class="flex items-center gap-2">
                    <div class="progress-bar-w h-1.5 rounded-full bg-white-20 overflow-hidden">
                        <div class="h-full rounded-full bg-[#fff] transition-all duration-300"
                             style="width: @GetDownloadPercent()%"></div>
                    </div>
                    <span class="text-[11px] font-mono whitespace-nowrap">@FormatBytes(Updater.DownloadedBytes) / @FormatBytes(Updater.DownloadTotalBytes)</span>
                </div>
            }
            else if (Updater.ErrorMessage is not null)
            {
                <div class="flex items-center gap-2">
                    <span class="text-[11px]">@Updater.ErrorMessage</span>
                    <button class="px-3 py-1 text-[12px] font-semibold rounded-[var(--radius-sm)] border border-white-40 bg-white-15 text-[#fff] cursor-pointer transition-colors duration-200 update-btn"
                            @onclick="DownloadUpdate">@L("UpdateNow")</button>
                </div>
            }
            else
            {
                <button class="px-3 py-1 text-[12px] font-semibold rounded-[var(--radius-sm)] border border-white-40 bg-white-15 text-[#fff] cursor-pointer transition-colors duration-200 update-btn"
                        @onclick="DownloadUpdate">@L("UpdateNow")</button>
            }
            <button class="p-1 rounded-[var(--radius-sm)] update-close transition-colors duration-150 cursor-pointer bg-transparent text-[#fff] border-none"
                    @onclick="() => Updater.UpdateDismissed = true" title="@L("Close")">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    </div>
}

<div class="flex flex-1 min-h-0 overflow-hidden">
    <!-- Sidebar -->
    <aside class="sidebar-w shrink-0 flex flex-col bg-[var(--bg-secondary)] border-r border-[var(--border)] h-full">
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border)]">
            <div class="flex items-center gap-2.5">
                <img src="_content/TordeX.UI/img/logo.png" alt="tordeX" width="32" height="32" />
                <span class="text-[18px] font-semibold text-[var(--accent)]">tordeX</span>
            </div>
            <button class="p-1.5 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors duration-150 cursor-pointer bg-transparent border-none"
                    title="@L("Settings")" @onclick="() => OpenSettings()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
            </button>
        </div>

        <!-- Tor Status -->
        <div class="px-3 py-2 border-b border-[var(--border)]">
            @if (_torConnecting)
            {
                <div class="flex items-center gap-2 px-1">
                    <span class="w-2 h-2 rounded-full bg-[var(--warning)]"
                          style="animation: pulse-dot 1.5s ease infinite;"></span>
                    <span class="text-[12px] text-[var(--warning)]">@L("ConnectingToTor")</span>
                </div>
            }
            else if (Chat.IsTorConnected)
            {
                <div class="flex flex-col gap-0.5 px-1 py-0.5 rounded-[var(--radius-sm)] bg-success-subtle">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-[var(--success)]" style="box-shadow: 0 0 6px var(--success);"></span>
                        <span class="text-[12px] text-[var(--success)] font-medium">@L("TorConnected")</span>
                    </div>
                    @if (Chat.OnionAddress is not null)
                    {
                        <span class="text-[9px] text-[var(--text-muted)] font-mono truncate pl-4" title="@Chat.OnionAddress">@Chat.OnionAddress[..16]...</span>
                    }
                </div>
            }
            else if (_torError is not null)
            {
                <div class="flex flex-col gap-1 px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-[var(--danger)]"></span>
                        <span class="text-[12px] text-[var(--danger)]">@L("TorFailed")</span>
                    </div>
                    <button class="text-[11px] text-[var(--text-muted)] hover:text-[var(--text-secondary)] transition-colors bg-transparent border-none cursor-pointer text-left"
                            @onclick="ConnectTor">@L("RetryConnection")</button>
                </div>
            }
            else
            {
                <button class="w-full flex items-center justify-center gap-2 px-3 py-2 text-[12px] font-semibold rounded-[var(--radius-md)] border border-[var(--accent)] text-[var(--accent)] bg-transparent cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-glow)]"
                        @onclick="ConnectTor">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="6" />
                        <circle cx="12" cy="12" r="2" />
                    </svg>
                    @L("ConnectToTorNetwork")
                </button>
            }
        </div>

        <!-- Tab Toggle: Rooms / DMs -->
        <div class="flex border-b border-[var(--border)]">
            <button class="flex-1 py-2 text-[12px] font-semibold text-center cursor-pointer transition-colors duration-200 border-none"
                    style="background: transparent; color: @(_sidebarTab == "rooms" ? "var(--accent)" : "var(--text-muted)"); border-bottom: 2px solid @(_sidebarTab == "rooms" ? "var(--accent)" : "transparent");"
                    @onclick='() => _sidebarTab = "rooms"'>
                @L("Rooms")
            </button>
            <button class="flex-1 py-2 text-[12px] font-semibold text-center cursor-pointer transition-colors duration-200 border-none relative"
                    style="background: transparent; color: @(_sidebarTab == "dms" ? "var(--accent)" : "var(--text-muted)"); border-bottom: 2px solid @(_sidebarTab == "dms" ? "var(--accent)" : "transparent");"
                    @onclick='() => _sidebarTab = "dms"'>
                @L("DirectMessages")
                @if (_rooms.Where(r => r.IsDm && r.UnreadCount > 0).Sum(r => r.UnreadCount) is var dmUnread && dmUnread > 0)
                {
                    <span class="absolute top-1 right-2 flex items-center justify-center w-4 h-4 rounded-full bg-[var(--accent)] text-[#fff] text-[9px] font-semibold">@dmUnread</span>
                }
            </button>
        </div>

        <!-- Room List / DM List -->
        <div class="flex-1 overflow-y-auto py-2">
            @if (_sidebarTab == "rooms")
            {
                var roomList = _rooms.Where(r => !r.IsDm).ToList();
                @if (roomList.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center h-full px-4 text-center">
                        <p class="text-[13px] text-[var(--text-muted)]">@L("NoRoomsYet")</p>
                        <p class="text-[12px] text-[var(--text-muted)] mt-1">@L("CreateOrJoinRoom")</p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col">
                        @foreach (var room in roomList)
                        {
                            <button class="flex items-center gap-3 px-3 py-2.5 transition-colors duration-150 cursor-pointer bg-transparent border-none w-full text-left"
                                    style="background: @(room.Id == _selectedRoomId ? "var(--bg-active)" : "transparent"); border-left: 3px solid @(room.Id == _selectedRoomId ? "var(--accent)" : "transparent");"
                                    @onclick="() => SelectRoom(room)"
                                    @oncontextmenu="(e) => ShowRoomContextMenu(e, room)" @oncontextmenu:preventDefault="true">
                                <div class="w-10 h-10 rounded-[var(--radius-md)] flex items-center justify-center shrink-0 bg-[var(--accent-glow)]">
                                    <span class="text-[16px] font-semibold text-[var(--accent)]">@(room.Name.Length > 0 ? room.Name[0].ToString().ToUpper() : "?")</span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[14px] font-semibold text-[var(--text-primary)] truncate">@room.Name</span>
                                    </div>
                                    <div class="flex items-center gap-1 mt-0.5">
                                        @if (_roomPasswords.ContainsKey(room.Id))
                                        {
                                            <span class="text-[11px] px-1.5 py-0.5 rounded-[var(--radius-sm)] bg-success-subtle-12 text-[var(--success)]">@L("Unlocked")</span>
                                        }
                                        else
                                        {
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                            </svg>
                                            <span class="text-[11px] text-[var(--text-muted)]">@L("Locked")</span>
                                        }
                                    </div>
                                </div>
                                @if (room.UnreadCount > 0)
                                {
                                    <span class="flex items-center justify-center badge-min-w h-5 px-1.5 rounded-full bg-[var(--accent)] text-[#fff] text-[11px] font-semibold">@room.UnreadCount</span>
                                }
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <!-- DM List -->
                var dmList = _rooms.Where(r => r.IsDm).ToList();
                @if (dmList.Count == 0)
                {
                    <div class="flex flex-col items-center justify-center h-full px-4 text-center">
                        <p class="text-[13px] text-[var(--text-muted)]">@L("NoDmsYet")</p>
                        <p class="text-[12px] text-[var(--text-muted)] mt-1">@L("ShareTokenHint")</p>
                    </div>
                }
                else
                {
                    <div class="flex flex-col">
                        @foreach (var dm in dmList)
                        {
                            <button class="flex items-center gap-3 px-3 py-2.5 transition-colors duration-150 cursor-pointer bg-transparent border-none w-full text-left"
                                    style="background: @(dm.Id == _selectedRoomId ? "var(--bg-active)" : "transparent"); border-left: 3px solid @(dm.Id == _selectedRoomId ? "var(--accent)" : "transparent");"
                                    @onclick="() => SelectDm(dm)"
                                    @oncontextmenu="(e) => ShowRoomContextMenu(e, dm)" @oncontextmenu:preventDefault="true">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 bg-[var(--accent-glow)]">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[14px] font-semibold text-[var(--text-primary)] truncate">@dm.Name</span>
                                    </div>
                                    <div class="flex items-center gap-1 mt-0.5">
                                        <span class="w-2 h-2 rounded-full @(dm.PeerFingerprint is not null && Chat.GetRoomPeerCount(dm.Id) > 0 ? "bg-[var(--success)]" : "bg-[var(--text-muted)]")" style="@(dm.PeerFingerprint is not null && Chat.GetRoomPeerCount(dm.Id) > 0 ? "box-shadow: 0 0 4px var(--success);" : "")"></span>
                                        <span class="text-[11px] text-[var(--text-muted)]">@(dm.PeerFingerprint is not null && Chat.GetRoomPeerCount(dm.Id) > 0 ? "Online" : "Offline")</span>
                                    </div>
                                </div>
                                @if (dm.UnreadCount > 0)
                                {
                                    <span class="flex items-center justify-center badge-min-w h-5 px-1.5 rounded-full bg-[var(--accent)] text-[#fff] text-[11px] font-semibold">@dm.UnreadCount</span>
                                }
                            </button>
                        }
                    </div>
                }
            }
        </div>

        <!-- Action Buttons -->
        <div class="px-3 py-3 border-t border-[var(--border)] flex flex-col gap-1.5">
            @if (_sidebarTab == "rooms")
            {
                <button class="w-full flex items-center justify-center gap-2 h-9 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[13px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="ShowCreateRoomDialog">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    @L("NewRoom")
                </button>
                <button class="w-full flex items-center justify-center gap-2 h-9 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)]"
                        @onclick="ShowJoinRoomDialog">
                    @L("JoinRoom")
                </button>
            }
            else
            {
                <button class="w-full flex items-center justify-center gap-2 h-9 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[13px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="ShowNewDmDialog">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    @L("NewDM")
                </button>
            }
        </div>

        <!-- User Profile -->
        <div class="px-3 py-3 border-t border-[var(--border)] flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-[var(--accent-glow)] flex items-center justify-center shrink-0">
                @if (Chat.CurrentUser?.AvatarData is { Length: > 0 })
                {
                    <img src="data:image/png;base64,@Convert.ToBase64String(Chat.CurrentUser.AvatarData)" alt="avatar" class="w-8 h-8 rounded-full" />
                }
                else
                {
                    <span class="text-[13px] font-semibold text-[var(--accent)]">@(Chat.CurrentUser?.DisplayName.Length > 0 ? Chat.CurrentUser.DisplayName[0].ToString().ToUpper() : "?")</span>
                }
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-[13px] text-[var(--text-primary)] truncate">@Chat.CurrentUser?.DisplayName</p>
                <p class="text-[11px] font-mono text-[var(--text-muted)] truncate">@Chat.UserFingerprint</p>
            </div>
            <button class="p-1.5 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors duration-150 cursor-pointer bg-transparent border-none"
                    title="Lock" @onclick="LockApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col relative">
        @if (_selectedRoom is not null && (_roomPasswords.ContainsKey(_selectedRoom.Id) || _selectedRoom.IsDm))
        {
            <ChatView Room="_selectedRoom" RoomPassword="_selectedRoomPassword" />
        }
        else
        {
            <!-- Empty State -->
            <div class="flex-1 flex flex-col items-center justify-center bg-[var(--bg-primary)] h-full">
                <img src="_content/TordeX.UI/img/logo.png" alt="tordeX" width="80" height="80" class="opacity-20 mb-4" />
                <h2 class="text-[16px] font-semibold text-[var(--text-muted)] mb-1">@L("WelcomeMessage")</h2>
                <p class="text-[13px] text-[var(--text-muted)] mb-6">@L("WelcomeSubtext")</p>
                <div class="flex items-center gap-3">
                    <button class="flex items-center gap-2 px-5 py-2.5 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[13px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                            @onclick="ShowCreateRoomDialog">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                        @L("NewRoom")
                    </button>
                    <button class="flex items-center gap-2 px-5 py-2.5 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)]"
                            @onclick="ShowJoinRoomDialog">
                        @L("JoinRoom")
                    </button>
                </div>
            </div>
        }

        <!-- Status Bar -->
        <div class="flex items-center justify-between px-4 py-1.5 border-t border-[var(--border)] bg-[var(--bg-secondary)]">
            <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--success)] glow-success-sm" style="@(!Chat.IsTorConnected ? "background: var(--danger); box-shadow: none;" : "")"></span>
                <span class="text-[11px] text-[var(--text-muted)]">Tor: @(Chat.IsTorConnected ? "Connected" : "Disconnected")</span>
            </div>
            <div class="flex items-center gap-1.5">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span class="text-[11px] text-[var(--success)]">@L("EndToEndEncrypted")</span>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Room Password Dialog -->
@if (_showRoomPassword)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="text-[18px] font-semibold mb-4 text-[var(--text-primary)]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" style="vertical-align: middle; margin-right: 8px;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                @L("UnlockRoom")
            </h2>
            <p class="text-[13px] text-[var(--text-secondary)] mb-4">
                @L("EnterPasswordFor") <strong class="text-[var(--text-primary)]">@_unlockRoomTarget?.Name</strong>
            </p>
            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomPassword")</label>
                    <input type="password" placeholder="@L("RoomPassword")"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_unlockPassword" @bind:event="oninput" @onkeydown="HandleUnlockKeyDown" />
                </div>
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <p class="text-[12px] text-[var(--danger)]">@_dialogError</p>
                }
                <button class="w-full h-10 mt-2 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[14px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="UnlockRoom">@L("Unlock")</button>
                <button class="w-full h-9 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                        @onclick="CloseDialogs">@L("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- Create Room Dialog -->
@if (_showCreateRoom)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="text-[18px] font-semibold mb-4 text-[var(--text-primary)]">@L("CreateNewRoom")</h2>
            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomName")</label>
                    <input type="text" placeholder="e.g. Security Research" maxlength="64"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_newRoomName" @bind:event="oninput" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomDescription") <span class="text-[var(--text-muted)]">(optional)</span></label>
                    <input type="text" placeholder="Brief room description" maxlength="256"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_newRoomDescription" @bind:event="oninput" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomPassword")</label>
                    <input type="password" placeholder="Secure password"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_newRoomPassword" @bind:event="oninput" />
                    <p class="text-[11px] text-[var(--text-muted)]">@L("SharePasswordHint")</p>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("MaxCapacity")</label>
                    <input type="number" min="0" placeholder="0 = unlimited"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_newRoomCapacity" @bind:event="oninput" />
                </div>
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <p class="text-[12px] text-[var(--danger)]">@_dialogError</p>
                }
                <button class="w-full h-10 mt-2 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[14px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="CreateRoom" disabled="@_dialogLoading">
                    @(_dialogLoading ? "Creating..." : L("CreateNewRoom"))
                </button>
                <button class="w-full h-9 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                        @onclick="CloseDialogs">@L("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- Join Room Dialog -->
@if (_showJoinRoom)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="text-[18px] font-semibold mb-4 text-[var(--text-primary)]">@L("JoinRoom")</h2>
            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomIdOrInvite")</label>
                    <input type="text" placeholder="@L("PasteRoomIdOrInvite")"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           value="@_joinInput" @oninput="OnJoinInputChanged" />
                    @if (_inviteLinkDetected)
                    {
                        <div class="flex items-center gap-1.5 mt-0.5" style="animation: fadeIn 200ms ease;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            <span class="text-[11px] text-[var(--success)]">@L("InviteLinkDetected")</span>
                        </div>
                    }
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomNameOptional") <span class="text-[var(--text-muted)]">(optional)</span></label>
                    <input type="text" placeholder="@L("RoomNameOptionalPlaceholder")"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_joinRoomName" @bind:event="oninput" />
                </div>
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("RoomPassword")</label>
                    <input type="password" placeholder="@L("RoomSharedPassword")"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_joinRoomPassword" @bind:event="oninput" />
                </div>
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <p class="text-[12px] text-[var(--danger)]">@_dialogError</p>
                }
                <button class="w-full h-10 mt-2 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[14px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="JoinRoom" disabled="@_dialogLoading">
                    @(_dialogLoading ? "Joining..." : L("JoinRoom"))
                </button>
                <button class="w-full h-9 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                        @onclick="CloseDialogs">@L("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- Delete Room Confirm -->
@if (_showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="text-[18px] font-semibold mb-4 text-[var(--danger)]">@L("DeleteRoom")</h2>
            <p class="text-[13px] text-[var(--text-secondary)] mb-4">
                @L("ConfirmDeleteRoom") <strong class="text-[var(--text-primary)]">@_deleteRoomTarget?.Name</strong>?
                @L("PermanentDeleteWarning")
            </p>
            <button class="w-full h-10 mt-2 rounded-[var(--radius-md)] bg-[var(--danger)] text-[#fff] text-[14px] font-semibold cursor-pointer transition-colors duration-200 hover:brightness-110 border-none"
                    @onclick="ConfirmDeleteRoom">@L("DeleteRoom")</button>
            <button class="w-full h-9 mt-2 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                    @onclick="CloseDialogs">@L("Cancel")</button>
        </div>
    </div>
}

<!-- New DM Dialog -->
@if (_showNewDm)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="text-[18px] font-semibold mb-4 text-[var(--text-primary)]">@L("NewDM")</h2>

            <!-- Your DM Token -->
            <div class="flex flex-col gap-1.5 mb-4 p-3 rounded-[var(--radius-md)] bg-[var(--bg-tertiary)] border border-[var(--border)]">
                <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("DmToken")</label>
                <p class="text-[11px] text-[var(--text-muted)]">@L("DmTokenDesc")</p>
                <div class="flex items-center gap-2 mt-1">
                    <code class="flex-1 text-[11px] font-mono text-[var(--text-secondary)] bg-[var(--bg-primary)] px-2 py-1.5 rounded-[var(--radius-sm)] truncate select-text">@(Chat.GetDmToken() ?? "Tor not connected")</code>
                    <button class="px-3 py-1.5 rounded-[var(--radius-sm)] text-[11px] font-semibold cursor-pointer transition-colors duration-200 border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]"
                            @onclick="CopyDmToken">@(_dmTokenCopied ? L("Copied") : L("CopyToken"))</button>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)] font-medium">@L("DmToken")</label>
                    <input type="text" placeholder="@L("PasteDmToken")"
                           class="w-full h-10 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           value="@_dmTokenInput" @oninput="OnDmTokenInputChanged" />
                    @if (_dmTokenDetected)
                    {
                        <div class="flex items-center gap-1.5 mt-0.5" style="animation: fadeIn 200ms ease;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            <span class="text-[11px] text-[var(--success)]">@L("DmTokenDetected")</span>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_dialogError))
                {
                    <p class="text-[12px] text-[var(--danger)]">@_dialogError</p>
                }
                <button class="w-full h-10 mt-2 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[14px] font-semibold cursor-pointer transition-colors duration-200 hover:bg-[var(--accent-light)] active:bg-[var(--accent-dark)] border-none"
                        @onclick="StartDirectMessage" disabled="@_dialogLoading">
                    @(_dialogLoading ? "Connecting..." : L("StartDirectMessage"))
                </button>
                <button class="w-full h-9 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer transition-colors duration-200 hover:bg-[var(--bg-hover)]"
                        @onclick="CloseDialogs">@L("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- Settings Dialog -->
@if (_showSettings)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-backdrop"></div>
        <div class="modal-card-wide" @onclick:stopPropagation="true">
            <!-- Fixed Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border)] shrink-0">
                <h2 class="text-[18px] font-semibold text-[var(--text-primary)]">@L("Settings")</h2>
                <button class="p-1.5 rounded-[var(--radius-sm)] hover:bg-[var(--bg-hover)] transition-colors cursor-pointer bg-transparent border-none"
                        @onclick="CloseDialogs">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto px-6 pb-6">
                <!-- PROFILE -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">Profile</h3>
                <div class="flex flex-col gap-3">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[12px] text-[var(--text-secondary)]">@L("DisplayName")</label>
                        <input type="text" maxlength="32"
                               class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                               @bind="_settingsDisplayName" @bind:event="oninput" />
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[12px] text-[var(--text-secondary)]">@L("YourFingerprint")</label>
                        <p class="text-[12px] font-mono text-[var(--text-secondary)] select-text bg-[var(--bg-tertiary)] px-3 py-2 rounded-[var(--radius-sm)]">@Chat.UserFingerprint</p>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[12px] text-[var(--text-secondary)]">@L("DmToken")</label>
                        <p class="text-[11px] text-[var(--text-muted)] mb-1">@L("DmTokenDesc")</p>
                        <div class="flex items-center gap-2">
                            <p class="flex-1 text-[12px] font-mono text-[var(--text-secondary)] select-text bg-[var(--bg-tertiary)] px-3 py-2 rounded-[var(--radius-sm)] truncate">@(Chat.GetDmToken() ?? "Tor not connected")</p>
                            <button class="px-3 py-1.5 rounded-[var(--radius-sm)] text-[11px] font-semibold cursor-pointer transition-colors duration-200 border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] hover:bg-[var(--bg-hover)]"
                                    @onclick="CopyDmToken">@(_dmTokenCopied ? L("Copied") : L("CopyToken"))</button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[12px] text-[var(--text-secondary)]">@L("PublicKey")</label>
                        <p class="text-[12px] font-mono text-[var(--text-secondary)] select-text bg-[var(--bg-tertiary)] px-3 py-2 rounded-[var(--radius-sm)] truncate">@(Chat.CurrentUser is not null ? Convert.ToBase64String(Chat.CurrentUser.PublicKey)[..40] + "..." : "")</p>
                    </div>
                </div>

                <!-- LANGUAGE -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("Language")</h3>
                <div class="relative">
                    <select class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] outline-none transition-all duration-200 input-focus-ring appearance-none cursor-pointer"
                            @onchange="OnLanguageChanged" value="@_settingsLanguage">
                        <option value="en">English</option>
                        <option value="tr">Turkce</option>
                    </select>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                </div>

                <!-- SECURITY INFO -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("SecurityInfo")</h3>
                <div class="rounded-[var(--radius-md)] bg-[var(--bg-tertiary)] border border-[var(--border)] p-3 flex flex-col gap-2">
                    <div class="flex items-center justify-between"><span class="text-[12px] text-[var(--text-muted)]">@L("Encryption")</span><span class="text-[12px] text-[var(--text-secondary)]">AES-256-GCM</span></div>
                    <div class="flex items-center justify-between"><span class="text-[12px] text-[var(--text-muted)]">@L("KeyDerivation")</span><span class="text-[12px] text-[var(--text-secondary)]">PBKDF2-SHA512 (600K iterations)</span></div>
                    <div class="flex items-center justify-between"><span class="text-[12px] text-[var(--text-muted)]">@L("KeyExchange")</span><span class="text-[12px] text-[var(--text-secondary)]">ECDH P-256 + HKDF</span></div>
                    <div class="flex items-center justify-between"><span class="text-[12px] text-[var(--text-muted)]">@L("Signatures")</span><span class="text-[12px] text-[var(--text-secondary)]">ECDSA P-256</span></div>
                    <div class="flex items-center justify-between"><span class="text-[12px] text-[var(--text-muted)]">@L("Network")</span><span class="text-[12px] text-[var(--text-secondary)]">Tor SOCKS5 Onion Routing</span></div>
                </div>

                <!-- CRYPTOGRAPHY -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("CryptoSettings")</h3>
                <div class="flex flex-col">
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("DoubleRatchet")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("DoubleRatchetDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secDoubleRatchet" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("PostQuantum")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("PostQuantumDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secPostQuantum" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("MultiLayerEncryption")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("MultiLayerEncryptionDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secMultiLayer" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("DeniableEncryption")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("DeniableEncryptionDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secDeniable" /><span class="toggle-slider"></span></label>
                    </div>
                </div>

                <!-- NETWORK SECURITY -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("NetworkSecurity")</h3>
                <div class="flex flex-col">
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("TrafficObfuscation")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("TrafficObfuscationDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secTrafficObf" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("TimingProtection")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("TimingProtectionDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secTiming" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("DnsLeakProtection")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("DnsLeakProtectionDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secDnsLeak" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("CertificatePinning")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("CertificatePinningDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secCertPinning" /><span class="toggle-slider"></span></label>
                    </div>
                </div>

                <!-- Tor Bridge -->
                <div class="mt-3 flex flex-col gap-2">
                    <label class="text-[12px] text-[var(--text-secondary)]">@L("TorBridge")</label>
                    <input type="text" placeholder="Bridge line"
                           class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_secBridgeLine" />
                    <div class="flex items-center gap-2">
                        @{ var transports = new[] { "obfs4", "meek", "snowflake" }; }
                        @foreach (var t in transports)
                        {
                            <button class="px-3 py-1.5 rounded-full text-[11px] font-medium cursor-pointer transition-colors duration-200 border @(_secTransport == t ? "bg-[var(--accent)] text-[#fff] border-[var(--accent)]" : "bg-transparent text-[var(--text-secondary)] border-[var(--border-light)] hover:bg-[var(--bg-hover)]")"
                                    @onclick="() => ToggleTransport(t)">@t</button>
                        }
                    </div>
                </div>

                <!-- Guard Node Pinning -->
                <div class="mt-3 flex flex-col gap-1.5">
                    <label class="text-[12px] text-[var(--text-secondary)]">@L("GuardPinning")</label>
                    <input type="text" placeholder="Fingerprints"
                           class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                           @bind="_secGuardNodes" />
                </div>

                <!-- DATA PROTECTION -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("DataProtection")</h3>
                <div class="flex flex-col">
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("RamOnlyMode")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("RamOnlyModeDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secRamOnly" /><span class="toggle-slider"></span></label>
                    </div>
                    @if (_secRamOnly)
                    {
                        <div class="px-3 py-2 mb-2 rounded-[var(--radius-sm)] bg-warning-subtle border border-warning-subtle">
                            <p class="text-[11px] text-[var(--warning)]">Messages will be lost when you close the app</p>
                        </div>
                    }
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("AutoMetadataStrip")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("AutoMetadataStripDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secAutoMeta" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div><p class="text-[13px] text-[var(--text-primary)]">@L("MemoryProtection")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("MemoryProtectionDesc")</p></div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-[var(--radius-sm)] bg-success-subtle-12 text-[var(--success)] text-[11px] font-medium">DPAPI</span>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div><p class="text-[13px] text-[var(--text-primary)]">@L("SecureWipe")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("SecureWipeDesc")</p></div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-[var(--radius-sm)] bg-success-subtle-12 text-[var(--success)] text-[11px] font-medium">DoD 5220</span>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("DeadManSwitch")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("DeadManSwitchDesc")</p></div>
                        <div class="flex items-center gap-2">
                            @if (_secDeadMan)
                            {
                                <input type="number" min="1" max="365"
                                       class="input-sm-w h-7 px-2 text-[12px] text-center rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] outline-none"
                                       @bind="_secDeadManDays" placeholder="days" />
                            }
                            <label class="toggle-switch"><input type="checkbox" @bind="_secDeadMan" /><span class="toggle-slider"></span></label>
                        </div>
                    </div>
                </div>

                <!-- THREAT MONITORING -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("ThreatMonitoring")</h3>
                <div class="flex flex-col">
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("TamperDetection")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("TamperDetectionDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secTamper" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("IntegrityMonitoring")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("IntegrityMonitoringDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secIntegrity" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div class="flex-1 min-w-0 mr-3"><p class="text-[13px] text-[var(--text-primary)]">@L("CanaryTokens")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("CanaryTokensDesc")</p></div>
                        <label class="toggle-switch"><input type="checkbox" @bind="_secCanary" /><span class="toggle-slider"></span></label>
                    </div>
                    <div class="flex items-center justify-between py-2.5 border-b border-[var(--border)]">
                        <div><p class="text-[13px] text-[var(--text-primary)]">@L("BruteForceProtection")</p><p class="text-[11px] text-[var(--text-muted)] mt-0.5">@L("MaxLoginAttempts")</p></div>
                        <input type="number" min="1"
                               class="input-sm-w h-7 px-2 text-[12px] text-center rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] outline-none"
                               @bind="_secMaxAttempts" />
                    </div>
                </div>

                <!-- AUTO-LOCK -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("AutoLock")</h3>
                <div class="relative">
                    <select class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] outline-none transition-all duration-200 input-focus-ring appearance-none cursor-pointer"
                            @bind="_settingsAutoLock">
                        <option value="0">@L("Never")</option>
                        <option value="1">1 minute</option>
                        <option value="5">5 minutes</option>
                        <option value="15">15 minutes</option>
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes</option>
                    </select>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
                </div>

                <!-- NOTIFICATION SOUNDS -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("NotificationSounds")</h3>
                <label class="toggle-switch"><input type="checkbox" @bind="_settingsNotifSounds" /><span class="toggle-slider"></span></label>

                <!-- SCREEN CAPTURE -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("ScreenCaptureProtection")</h3>
                <div class="flex items-center justify-between">
                    <p class="text-[12px] text-[var(--text-muted)]">Window appears black in screenshots</p>
                    <label class="toggle-switch"><input type="checkbox" @bind="_settingsScreenCapture" /><span class="toggle-slider"></span></label>
                </div>

                <!-- CHANGE PASSWORD -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("ChangePassword")</h3>
                <button class="flex items-center gap-2 text-[13px] text-[var(--accent)] cursor-pointer bg-transparent border-none hover:text-[var(--accent-light)] transition-colors"
                        @onclick="() => _showPasswordChange = !_showPasswordChange">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         style="transform: @(_showPasswordChange ? "rotate(90deg)" : "rotate(0deg)"); transition: transform 200ms;">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                    @(_showPasswordChange ? "Hide" : L("ChangePassword"))
                </button>
                @if (_showPasswordChange)
                {
                    <div class="flex flex-col gap-3 mt-3 p-3 rounded-[var(--radius-md)] bg-[var(--bg-tertiary)] border border-[var(--border)]">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[12px] text-[var(--text-secondary)]">@L("CurrentPassword")</label>
                            <input type="password"
                                   class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                                   @bind="_pwdCurrent" @bind:event="oninput" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[12px] text-[var(--text-secondary)]">@L("NewPassword")</label>
                            <input type="password"
                                   class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                                   @bind="_pwdNew" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_pwdNew))
                            {
                                var strength = GetPasswordStrength(_pwdNew);
                                <div class="flex items-center gap-1 mt-1">
                                    @for (int seg = 1; seg <= 4; seg++)
                                    {
                                        var segLocal = seg;
                                        <div class="flex-1 h-1 rounded-full" style="background: @(segLocal <= strength ? (strength <= 1 ? "var(--danger)" : strength <= 3 ? "var(--warning)" : "var(--success)") : "var(--border)");"></div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[12px] text-[var(--text-secondary)]">@L("ConfirmNewPassword")</label>
                            <input type="password"
                                   class="w-full h-9 px-3 text-[13px] rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] outline-none transition-all duration-200 input-focus-ring"
                                   @bind="_pwdConfirm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_pwdConfirm))
                            {
                                <p class="text-[11px] @(_pwdNew == _pwdConfirm ? "text-[var(--success)]" : "text-[var(--danger)]")">
                                    @(_pwdNew == _pwdConfirm ? "Passwords match" : "Passwords do not match")
                                </p>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_pwdError))
                        {
                            <p class="text-[12px] text-[var(--danger)]">@_pwdError</p>
                        }
                        @if (!string.IsNullOrEmpty(_pwdSuccess))
                        {
                            <p class="text-[12px] text-[var(--success)]">@_pwdSuccess</p>
                        }
                        <div class="flex items-center gap-2 mt-1">
                            <button class="px-4 py-1.5 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[12px] font-semibold cursor-pointer border-none hover:bg-[var(--accent-light)] transition-colors"
                                    @onclick="ChangePassword" disabled="@_pwdLoading">@(_pwdLoading ? "Changing..." : L("Save"))</button>
                            <button class="px-4 py-1.5 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[12px] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors"
                                    @onclick="() => _showPasswordChange = false">@L("Cancel")</button>
                        </div>
                    </div>
                }

                <!-- BLOCKED USERS -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] font-semibold mt-6 mb-3">@L("BlockedUsers")</h3>
                @if (_blockedUsers.Count == 0)
                {
                    <p class="text-[12px] text-[var(--text-muted)]">@L("NoBlockedUsers")</p>
                }
                else
                {
                    @foreach (var blocked in _blockedUsers)
                    {
                        <div class="flex items-center justify-between py-2 border-b border-[var(--border)]">
                            <div>
                                <p class="text-[13px] text-[var(--text-primary)]">@(blocked.DisplayName ?? "Unknown")</p>
                                <p class="text-[11px] text-[var(--text-muted)] font-mono">@blocked.Fingerprint[..16]...</p>
                            </div>
                            <button class="px-3 py-1.5 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[12px] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors"
                                    @onclick="() => UnblockUser(blocked.Fingerprint)">@L("Unblock")</button>
                        </div>
                    }
                }

                <!-- PANIC BUTTON -->
                <h3 class="text-[11px] uppercase tracking-wider text-[var(--danger)] font-semibold mt-6 mb-3">@L("PanicButton")</h3>
                @if (!_showPanicConfirm)
                {
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-[var(--radius-md)] bg-[var(--danger)] text-[#fff] text-[13px] font-semibold cursor-pointer border-none hover:brightness-110 transition-all"
                            @onclick="() => _showPanicConfirm = true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        @L("DeleteAllData")
                    </button>
                }
                else
                {
                    <div class="p-3 rounded-[var(--radius-md)] border-2 border-[var(--danger)] bg-danger-subtle">
                        <p class="text-[13px] text-[var(--danger)] font-semibold mb-3">@L("CannotBeUndone")</p>
                        <div class="flex items-center gap-2">
                            <button class="px-4 py-2 rounded-[var(--radius-md)] bg-[var(--danger)] text-[#fff] text-[12px] font-semibold cursor-pointer border-none hover:brightness-110 transition-all uppercase tracking-wider"
                                    @onclick="ExecutePanicWipe" disabled="@_panicLoading">@(_panicLoading ? "WIPING..." : "CONFIRM WIPE")</button>
                            <button class="px-4 py-2 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[12px] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors"
                                    @onclick="() => _showPanicConfirm = false">@L("Cancel")</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_settingsError))
                {
                    <p class="text-[12px] text-[var(--danger)] mt-2">@_settingsError</p>
                }
                @if (!string.IsNullOrEmpty(_settingsSuccess))
                {
                    <p class="text-[12px] text-[var(--success)] mt-2">@_settingsSuccess</p>
                }
            </div>

            <!-- Fixed Footer -->
            <div class="flex items-center justify-end gap-2 px-6 py-3 border-t border-[var(--border)] shrink-0">
                <button class="px-4 py-2 rounded-[var(--radius-md)] border border-[var(--border-light)] bg-transparent text-[var(--text-secondary)] text-[13px] cursor-pointer hover:bg-[var(--bg-hover)] transition-colors"
                        @onclick="CloseDialogs">@L("Close")</button>
                <button class="px-5 py-2 rounded-[var(--radius-md)] bg-[var(--accent)] text-[#fff] text-[13px] font-semibold cursor-pointer border-none hover:bg-[var(--accent-light)] transition-colors"
                        @onclick="SaveSettings">@L("Save")</button>
            </div>
        </div>
    </div>
}

<!-- Panic Wipe Full-Screen Overlay -->
@if (_panicWiping)
{
    <div class="fixed inset-0 flex items-center justify-center bg-[var(--bg-primary)]" style="z-index: 5000;">
        <div class="flex flex-col items-center gap-4 text-center">
            <h3 class="text-[20px] font-semibold text-[var(--danger)]">WIPING ALL DATA...</h3>
            <p class="text-[13px] text-[var(--text-muted)]">Securely overwriting and deleting all files. Do not close the application.</p>
        </div>
    </div>
}

@code {
    private List<ChatRoom> _rooms = [];
    private ChatRoom? _selectedRoom;
    private string _selectedRoomId = string.Empty;
    private string _selectedRoomPassword = string.Empty;

    // Sidebar tab
    private string _sidebarTab = "rooms";

    // Dialog state
    private bool _showCreateRoom;
    private bool _showJoinRoom;
    private bool _showRoomPassword;
    private bool _showDeleteConfirm;
    private bool _showSettings;
    private bool _showNewDm;
    private string _newRoomName = string.Empty;
    private string _newRoomPassword = string.Empty;
    private string _newRoomDescription = string.Empty;
    private int _newRoomCapacity;
    private string _joinInput = string.Empty;
    private string _joinRoomId = string.Empty;
    private string _joinRoomName = string.Empty;
    private string _joinRoomPassword = string.Empty;
    private string _joinInviteToken = string.Empty;
    private string _joinOnionAddress = string.Empty;
    private bool _inviteLinkDetected;
    private string _unlockPassword = string.Empty;
    private ChatRoom? _unlockRoomTarget;
    private ChatRoom? _deleteRoomTarget;
    private string _dialogError = string.Empty;
    private bool _dialogLoading;

    // Settings
    private string _settingsDisplayName = string.Empty;
    private string _settingsLanguage = "en";
    private int _settingsAutoLock;
    private bool _settingsNotifSounds = true;
    private bool _settingsScreenCapture;

    // Security settings fields
    private bool _secDoubleRatchet = true;
    private bool _secPostQuantum;
    private bool _secMultiLayer;
    private bool _secDeniable;
    private bool _secTrafficObf = true;
    private bool _secTiming = true;
    private bool _secDnsLeak = true;
    private bool _secCertPinning;
    private string? _secBridgeLine;
    private string? _secTransport;
    private string? _secGuardNodes;
    private bool _secRamOnly;
    private bool _secAutoMeta = true;
    private bool _secDeadMan;
    private int _secDeadManDays = 30;
    private bool _secTamper = true;
    private bool _secIntegrity = true;
    private bool _secCanary = true;
    private int _secMaxAttempts = 5;
    private string _settingsError = string.Empty;
    private string _settingsSuccess = string.Empty;

    // Password change
    private bool _showPasswordChange;
    private string _pwdCurrent = string.Empty;
    private string _pwdNew = string.Empty;
    private string _pwdConfirm = string.Empty;
    private string _pwdError = string.Empty;
    private string _pwdSuccess = string.Empty;
    private bool _pwdLoading;

    // Blocked users
    private List<BlockedUser> _blockedUsers = [];

    // Panic
    private bool _showPanicConfirm;
    private bool _panicLoading;
    private bool _panicWiping;

    // DM
    private string _dmTokenInput = string.Empty;
    private string _dmPeerOnion = string.Empty;
    private string _dmPeerFingerprint = string.Empty;
    private bool _dmTokenDetected;
    private bool _dmTokenCopied;

    // Tor
    private bool _torConnecting;
    private string? _torError;

    // Room passwords (in-memory only, never stored plaintext)
    private readonly Dictionary<string, string> _roomPasswords = new();

    // Localization helper
    private static string L(string key) => LocalizationService.T(key);

    private void ToggleTransport(string transport) =>
        _secTransport = _secTransport == transport ? null : transport;

    protected override async Task OnInitializedAsync()
    {
        _rooms = await Chat.GetRoomsAsync();
        LoadSettingsFromProfile();

        // Set language
        LocalizationService.CurrentLanguage = _settingsLanguage;

        // Listen for auto-update state changes
        Updater.OnStateChanged += OnUpdaterStateChanged;

        // Auto-connect to Tor in background
        if (!Chat.IsTorConnected)
        {
            _ = AutoConnectTorAsync();
        }

        // Check for updates in background
        _ = Updater.CheckForUpdateAsync();
    }

    private async Task AutoConnectTorAsync()
    {
        _torConnecting = true;
        _torError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Chat.StartTorAsync();

            // Subscribe to peer status changes to refresh UI
            Chat.OnPeerStatusChanged += OnPeerStatusChanged;
            Chat.OnConnectionFailed += OnConnectionFailed;
            Chat.OnDmAccepted += OnDmAccepted;

            // Auto-reconnect to rooms with known onion addresses
            _ = ReconnectToRoomPeersAsync();
        }
        catch (Exception ex)
        {
            _torError = $"{ex.Message} (Check logs for details)";
            Console.WriteLine($"[Tor Error] {ex}");
        }
        finally
        {
            _torConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnPeerStatusChanged(string fingerprint, bool connected)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnConnectionFailed(string roomId, string errorMessage)
    {
        _ = InvokeAsync(() =>
        {
            _torError = errorMessage;
            StateHasChanged();
        });
    }

    private void OnDmAccepted(ChatRoom dm)
    {
        _ = InvokeAsync(() =>
        {
            // Add the new DM room to the rooms list if not already there
            if (!_rooms.Any(r => r.Id == dm.Id))
            {
                _rooms.Insert(0, dm);
            }
            // Switch to DMs tab to make it visible
            _sidebarTab = "dms";
            StateHasChanged();
        });
    }

    private async Task ReconnectToRoomPeersAsync()
    {
        // Unlock all rooms we have passwords for + DM rooms
        foreach (var room in _rooms)
        {
            if (room.IsDm)
            {
                // DM rooms unlock without password
                Chat.UnlockDmRoom(room.Id);
            }
            else if (_roomPasswords.TryGetValue(room.Id, out var pwd))
            {
                Chat.UnlockRoom(room.Id, pwd, room.RoomSalt);
            }

            // Connect to rooms with a stored peer onion address
            if (!string.IsNullOrEmpty(room.OnionAddress))
            {
                try
                {
                    await Chat.ConnectToRoomPeerAsync(room.Id, room.OnionAddress);
                }
                catch { /* best effort — retry timer will handle it */ }
            }
        }

        // Also try reconnecting via in-memory known peer addresses (covers creator rooms)
        try
        {
            await Chat.TryReconnectPeersAsync();
        }
        catch { /* best effort */ }
    }

    // ──────── Room Selection ────────

    private void SelectRoom(ChatRoom room)
    {
        Chat.ResetActivityTimer();

        if (!_roomPasswords.TryGetValue(room.Id, out var password))
        {
            _unlockRoomTarget = room;
            _unlockPassword = string.Empty;
            _dialogError = string.Empty;
            _showRoomPassword = true;
            return;
        }

        ActivateRoom(room, password);
    }

    private void ActivateRoom(ChatRoom room, string password)
    {
        _selectedRoom = room;
        _selectedRoomId = room.Id;
        _selectedRoomPassword = password;
        Chat.UnlockRoom(room.Id, password, room.RoomSalt);
        StateHasChanged();
    }

    private async Task HandleUnlockKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await UnlockRoom();
    }

    private async Task UnlockRoom()
    {
        _dialogError = string.Empty;

        if (string.IsNullOrWhiteSpace(_unlockPassword))
        {
            _dialogError = "Password is required.";
            return;
        }

        if (_unlockRoomTarget is null) return;

        // Derive key and try to load messages to verify password
        Chat.UnlockRoom(_unlockRoomTarget.Id, _unlockPassword, _unlockRoomTarget.RoomSalt);
        try
        {
            await Chat.GetMessagesAsync(_unlockRoomTarget.Id, limit: 1);
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            _dialogError = "Wrong password. Cannot decrypt room messages.";
            return;
        }
        catch
        {
            // No messages yet or other non-crypto error — password might be correct for a new room
        }

        _roomPasswords[_unlockRoomTarget.Id] = _unlockPassword;
        ActivateRoom(_unlockRoomTarget, _unlockPassword);
        _showRoomPassword = false;
        _unlockRoomTarget = null;
    }

    // ──────── Room Context Menu ────────

    private void ShowRoomContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, ChatRoom room)
    {
        _deleteRoomTarget = room;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteRoom()
    {
        if (_deleteRoomTarget is null) return;

        try
        {
            await Chat.DeleteRoomAsync(_deleteRoomTarget.Id);
            _rooms.Remove(_deleteRoomTarget);
            _roomPasswords.Remove(_deleteRoomTarget.Id);

            if (_selectedRoomId == _deleteRoomTarget.Id)
            {
                _selectedRoom = null;
                _selectedRoomId = string.Empty;
            }
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }

        _deleteRoomTarget = null;
        _showDeleteConfirm = false;
        StateHasChanged();
    }

    // ──────── Tor ────────

    private async Task ConnectTor()
    {
        _torConnecting = true;
        _torError = null;
        StateHasChanged();

        try
        {
            await Chat.StartTorAsync();
        }
        catch (Exception ex)
        {
            _torError = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Tor connection failed: {ex.Message}");
        }
        finally
        {
            _torConnecting = false;
            StateHasChanged();
        }
    }

    // ──────── Dialogs ────────

    private void ShowCreateRoomDialog()
