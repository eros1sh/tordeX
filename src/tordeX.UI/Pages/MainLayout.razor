        }

        try
        {
            if (Chat.CurrentUser is not null)
            {
                Chat.CurrentUser.DisplayName = _settingsDisplayName.Trim();
                Chat.CurrentUser.Language = _settingsLanguage;
                Chat.CurrentUser.AutoLockMinutes = _settingsAutoLock;
                Chat.CurrentUser.NotificationSounds = _settingsNotifSounds;
                Chat.CurrentUser.ScreenCaptureProtection = _settingsScreenCapture;
                Chat.CurrentUser.DoubleRatchetEnabled = _secDoubleRatchet;
                Chat.CurrentUser.PostQuantumEnabled = _secPostQuantum;
                Chat.CurrentUser.MultiLayerEncryption = _secMultiLayer;
                Chat.CurrentUser.DeniableEncryption = _secDeniable;
                Chat.CurrentUser.TrafficObfuscation = _secTrafficObf;
                Chat.CurrentUser.TimingProtection = _secTiming;
                Chat.CurrentUser.DnsLeakProtection = _secDnsLeak;
                Chat.CurrentUser.RamOnlyMode = _secRamOnly;
                Chat.CurrentUser.AutoMetadataStrip = _secAutoMeta;
                Chat.CurrentUser.DeadManSwitch = _secDeadMan;
                Chat.CurrentUser.DeadManSwitchDays = _secDeadManDays;
                Chat.CurrentUser.TamperDetection = _secTamper;
                Chat.CurrentUser.IntegrityMonitoring = _secIntegrity;
                Chat.CurrentUser.CanaryTokens = _secCanary;
                Chat.CurrentUser.MaxLoginAttempts = _secMaxAttempts;
                Chat.CurrentUser.TorBridgeLine = _secBridgeLine;
                Chat.CurrentUser.TorPluggableTransport = _secTransport;
                Chat.CurrentUser.PinnedGuardNodes = _secGuardNodes;

                await Chat.UpdateProfileAsync();
            }

            // Apply screen capture protection immediately
            ApplyScreenCaptureProtection(_settingsScreenCapture);

            LocalizationService.CurrentLanguage = _settingsLanguage;

            _settingsSuccess = L("SettingsSaved");
            StateHasChanged();
