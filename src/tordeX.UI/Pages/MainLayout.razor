    private int GetDownloadPercent()
    {
        if (Updater.DownloadTotalBytes <= 0) return 0;
        return (int)(Updater.DownloadedBytes * 100 / Updater.DownloadTotalBytes);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    // ──────── Join Room (Smart Input) ────────

    private void OnJoinInputChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        _joinInput = value;

        const string prefix = "tordex://join/";
        if (value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            var remainder = value[prefix.Length..];
            var parts = remainder.Split('/', 3, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 1)
            {
                _joinRoomId = parts[0];
                _joinInviteToken = parts.Length >= 2 ? parts[1] : string.Empty;
                _joinOnionAddress = (parts.Length >= 3 ? parts[2] : string.Empty).Trim();
                _inviteLinkDetected = true;
                return;
            }
        }

        // Not an invite link — treat as plain room ID
        _inviteLinkDetected = false;
        _joinRoomId = string.Empty;
        _joinInviteToken = string.Empty;
        _joinOnionAddress = string.Empty;
    }

    // ──────── Direct Messages ────────

    private void ShowNewDmDialog()
    {
        CloseDialogs();
        _showNewDm = true;
        _dialogError = string.Empty;
        _dmTokenInput = string.Empty;
        _dmPeerOnion = string.Empty;
        _dmPeerFingerprint = string.Empty;
        _dmTokenDetected = false;
        _dmTokenCopied = false;
    }

    private void OnDmTokenInputChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        _dmTokenInput = value;

        var parsed = ChatService.ParseDmToken(value);
        if (parsed.HasValue)
        {
            _dmPeerOnion = parsed.Value.onionAddress;
            _dmPeerFingerprint = parsed.Value.fingerprint;
            _dmTokenDetected = true;
        }
        else
        {
            _dmTokenDetected = false;
            _dmPeerOnion = string.Empty;
            _dmPeerFingerprint = string.Empty;
        }
    }

    private async Task StartDirectMessage()
    {
        _dialogError = string.Empty;

        if (!_dmTokenDetected || string.IsNullOrEmpty(_dmPeerOnion) || string.IsNullOrEmpty(_dmPeerFingerprint))
        {
            _dialogError = L("InvalidDmToken");
            return;
        }

        if (_dmPeerFingerprint == Chat.UserFingerprint)
        {
            _dialogError = L("CannotDmSelf");
            return;
        }

        _dialogLoading = true;
        StateHasChanged();

        try
        {
            var dm = await Chat.CreateDirectMessageAsync(_dmPeerOnion, _dmPeerFingerprint);

            // Add to room list if not already there
            if (!_rooms.Any(r => r.Id == dm.Id))
            {
                _rooms.Insert(0, dm);
            }

            // Switch to DMs tab and select
            _sidebarTab = "dms";
            SelectDm(dm);
            _showNewDm = false;

            // Connect to peer in background
            _ = Task.Run(async () =>
            {
                try
                {
                    await Chat.ConnectToRoomPeerAsync(dm.Id, _dmPeerOnion);
                    await InvokeAsync(StateHasChanged);
                }
                catch { /* retry timer will handle it */ }
            });
        }
        catch (Exception ex)
        {
            _dialogError = $"Failed: {ex.Message}";
        }
        finally
        {
            _dialogLoading = false;
            StateHasChanged();
        }
    }

    private void SelectDm(ChatRoom dm)
    {
        Chat.ResetActivityTimer();
        Chat.UnlockDmRoom(dm.Id);
        _selectedRoom = dm;
        _selectedRoomId = dm.Id;
        _selectedRoomPassword = ""; // DMs don't use password
        StateHasChanged();
    }

    private async Task CopyDmToken()
    {
        var token = Chat.GetDmToken();
        if (token is not null)
        {
            try
            {
                await Platform.CopyToClipboardAsync(token);
                _dmTokenCopied = true;
                StateHasChanged();
                await Task.Delay(2000);
                _dmTokenCopied = false;
                StateHasChanged();
            }
            catch { /* clipboard not available */ }
        }
    }

    // ──────── Panic Wipe ────────

    private async Task ExecutePanicWipe()
    {
        _panicLoading = true;
        _panicWiping = true;
        StateHasChanged();

        try
        {
            await Chat.PanicWipeAsync();

            // Force application exit after wipe
            Platform.RequestShutdown();
        }
        catch (Exception ex)
        {
            _panicLoading = false;
            _panicWiping = false;
            _settingsError = $"Wipe failed: {ex.Message}";
            StateHasChanged();
        }
    }

