@using TordeX.Core.Services
@inject ChatService Chat

@if (!_isLoggedIn)
{
    <LoginPage OnLoggedIn="HandleLoggedIn" />
}
else if (Chat.IsLocked)
{
    <!-- Auto-Lock Overlay (matches Next.js LockScreen) -->
    <div class="fixed inset-0 flex flex-col items-center justify-center bg-[var(--bg-primary)]" style="z-index: 5000;">
        <div class="flex flex-col items-center gap-4 w-full" style="max-width: 320px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                <circle cx="12" cy="16" r="1" fill="var(--accent)" />
            </svg>
            <h2 class="text-[20px] font-semibold text-[var(--text-primary)]">tordeX Locked</h2>
            <p class="text-[13px] text-[var(--text-muted)]">Enter your password to unlock</p>
            <form class="w-full flex flex-col items-center gap-3 mt-2" @onsubmit="TryUnlock" @onsubmit:preventDefault>
                <input type="password" placeholder="Enter password" autofocus
                       class="w-full h-11 px-4 text-[16px] text-center tracking-[4px] rounded-[var(--radius-md)] border bg-[var(--bg-tertiary)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] placeholder:tracking-normal outline-none transition-all duration-200 input-focus-ring"
                       style="border-color: @(!string.IsNullOrEmpty(_lockError) ? "var(--danger)" : "var(--border)"); box-shadow: @(!string.IsNullOrEmpty(_lockError) ? "0 0 0 3px rgba(231, 76, 60, 0.3)" : "none");"
                       @bind="_unlockPassword" @bind:event="oninput"
                       @onkeydown="HandleLockKeyDown" />
                @if (!string.IsNullOrEmpty(_lockError))
                {
                    <p class="text-[12px] text-[var(--danger)]">@_lockError</p>
                }
            </form>
            <div class="flex items-center gap-1.5 mt-6">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <span class="text-[11px] text-[var(--text-muted)]">Locked due to inactivity</span>
            </div>
        </div>
    </div>
}
else
{
    <MainLayout />
}

@code {
    private bool _isLoggedIn;
    private string _unlockPassword = string.Empty;
    private string _lockError = string.Empty;

    protected override void OnInitialized()
    {
        _isLoggedIn = Chat.IsInitialized;
        Chat.OnAutoLocked += HandleAutoLocked;
    }

    private void HandleLoggedIn()
    {
        _isLoggedIn = true;
        StateHasChanged();
    }

    private void HandleAutoLocked()
    {
        _unlockPassword = string.Empty;
        _lockError = string.Empty;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLockKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await TryUnlock();
    }

    private async Task TryUnlock()
    {
        _lockError = string.Empty;

        if (string.IsNullOrWhiteSpace(_unlockPassword))
        {
            _lockError = "Password is required.";
            return;
        }

        var ok = await Chat.UnlockAppAsync(_unlockPassword);
        if (!ok)
        {
            _lockError = "Invalid password. Please try again.";
            _unlockPassword = string.Empty;
            return;
        }

        _unlockPassword = string.Empty;
        StateHasChanged();
    }

    public void Dispose()
    {
        Chat.OnAutoLocked -= HandleAutoLocked;
    }
}
