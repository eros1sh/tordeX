<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TordeX.Core</RootNamespace>
    <AssemblyName>TordeX.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cryptography: libsodium wrapper (audited, high-performance) -->
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />

    <!-- Encrypted SQLite database (SQLCipher bundle with native encryption support) -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />

    <!-- Binary serialization (compact, fast) -->
    <PackageReference Include="MessagePack" Version="3.1.3" />

    <!-- Tor: managed directly via Process (no TorSharp dependency) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- Embedded Tor binary - copied to output directory -->
  <ItemGroup>
    <Content Include="tor.exe" Condition="Exists('tor.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Also copy from Resources folder if present -->
    <Content Include="Resources\**\*" Condition="Exists('Resources')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
