<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TordeX.Linux</RootNamespace>
    <AssemblyName>tordeX</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tordeX.Core\tordeX.Core.csproj" />
    <ProjectReference Include="..\tordeX.UI\tordeX.UI.csproj" />
  </ItemGroup>

</Project>
